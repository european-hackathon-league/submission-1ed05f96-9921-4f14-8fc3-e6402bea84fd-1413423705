# Dixi backend: copy to backend/.env (git-ignored) and fill in.
# Server-side only. These values must never reach the browser.

ENVIRONMENT=development
API_PORT=8000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# OpenAI
OPENAI_API_KEY=
# Cheap/fast model for labelling and clustering; strong model for drafting requirements
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_STRONG=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Supabase (local defaults from `supabase start`; hosted values from the dashboard)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Tracing for Pydantic AI (optional)
LOGFIRE_TOKEN=

# Video generation via fal.ai (optional, not core)
FAL_KEY=
