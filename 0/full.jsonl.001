es[\"2–3 car profiles\"]","+  build --> profiles[\"3 car profiles<br/>Fix the basics · Tech-forward · Comfort &amp; craft<br/>score = L1 (principles + your priority) + L2 coverage\"]"," ","-  profiles --> page[\"Profile page<br/>requirements · why the agent chose them<br/>competitors · Decisions (incl. rejects + reasons)\"]","+  profiles --> page[\"Profile page<br/>requirements in your priority order · draft targets<br/>related options + price · competitors &amp; trends<br/>why the agent chose it · Decisions incl. reject reasons\"]","   mem --> page"," ","   page -. \"optional\" .-> post[\"Post the profiles on social media\"]","-  post --> l3[\"L3 · Which profile performs better<br/>low weight\"]","+  post --> l3[\"L3 · Which profile performs better<br/>low weight per series\"]","   l3 --> dash[\"Dashboard<br/>profile scores per market\"]","   page --> dash"," "]},{"oldStart":47,"oldLines":8,"newStart":59,"newLines":8,"lines":["   classDef layer fill:#eef1f6,stroke:#5b6676,color:#121722"," ","   class landing,picker,series,list,page,dash screen","-  class cluster,cat,urgency,build,profiles ai","-  class pick,why,kept human","+  class cluster,cat,urgency,link,build,profiles ai","+  class pick,why,kept,prio,wish human","   class mem memory","-  class l1,l2in,l3,post layer","+  class l1,l2in,research,l3,post layer"," ```"]}],"originalFile":"# Product manager workflow\n\nThe product manager's path: market → series → AI clusters feature requests (Exterior · Interior · Digital · Powertrain, by urgency) → keep or reject (a reject needs a reason, saved in Decisions) → build car profiles → optional social test (L3).\n\n```mermaid\nflowchart TD\n  %% The product manager's path through Dixi, screen by screen.\n  %% Layers: L1 = BMW principles · L2 = customer feedback, trends and competitors · L3 = social response to the profiles (low weight).\n  %% Every reject asks for a reason; the reason is saved as a decision and shown on the profile it shaped.\n\n  landing[\"Landing page\"] --> picker[\"Dashboard<br/>globe: pick a market\"]\n  picker --> series[\"Pick a series<br/>1 · 5 · 7\"]\n  series --> analyse\n\n  subgraph analyse [\"AI analysis\"]\n    direction TB\n    l2in[\"L2 · Feedback, trends, competitors<br/>likes · dislikes · wishes\"]\n    cluster[\"Compress + cluster<br/>into feature requests\"]\n    cat[\"Categorise<br/>Exterior · Interior · Digital · Powertrain\"]\n    urgency[\"Urgency<br/>how many customers ask for it\"]\n    l2in --> cluster --> cat --> urgency\n  end\n\n  urgency --> list[\"Feature request list<br/>filter by category + urgency\"]\n  list --> pick{{\"PM decides per request\"}}\n  pick -- \"Keep\" --> kept[\"Selected requests\"]\n  pick -- \"Reject\" --> why[\"Reason box<br/>why is it rejected?<br/>(required)\"]\n  why --> mem[(\"Decisions<br/>request · reason · who · when<br/>evidence snapshot\")]\n\n  kept --> build[\"Build\"]\n  l1[\"L1 · BMW principles<br/>fundamentals per market\"] --> build\n  mem -. \"rejected requests stay out\" .-> build\n  build --> profiles[\"2–3 car profiles\"]\n\n  profiles --> page[\"Profile page<br/>requirements · why the agent chose them<br/>competitors · Decisions (incl. rejects + reasons)\"]\n  mem --> page\n\n  page -. \"optional\" .-> post[\"Post the profiles on social media\"]\n  post --> l3[\"L3 · Which profile performs better<br/>low weight\"]\n  l3 --> dash[\"Dashboard<br/>profile scores per market\"]\n  page --> dash\n\n  classDef screen fill:#ffffff,stroke:#1c69d4,color:#121722\n  classDef ai fill:#e8f0fc,stroke:#1c69d4,color:#121722\n  classDef human fill:#fdecea,stroke:#e22718,color:#121722,stroke-width:2px\n  classDef memory fill:#0f3d75,stroke:#0f3d75,color:#ffffff\n  classDef layer fill:#eef1f6,stroke:#5b6676,color:#121722\n\n  class landing,picker,series,list,page,dash screen\n  class cluster,cat,urgency,build,profiles ai\n  class pick,why,kept human\n  class mem memory\n  class l1,l2in,l3,post layer\n```\n","userModified":false},"sourceToolAssistantUUID":"5b2f51a