{"parentUuid":"99c14a4a-93f6-44b1-8753-eaeb740d144e","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfuBajfTHQPS5YR5tnfo8","type":"message","role":"assistant","content":[{"type":"text","text":"Plan:\n- **Decision memory:** every past keep and reject, with its reason, person, date and how many customers asked at that moment, is collected from earlier generations.\n- **A visible Dixi score:** it ranks the feature list, with memory built in:\n  - A past reject pushes the request down, and that penalty fades over time.\n  - If demand has grown clearly since the reject, the request **resurfaces** with a badge.\n- **Settings page:** in the dashboard, to tune the weights.\n- **Architecture docs:** cover the scoring and how the backend AI will use this memory.\n\nStarting with the scoring engine:"}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":220,"cache_read_input_tokens":544264,"output_tokens":5003,"output_tokens_details":{"thinking_tokens":1932},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":220,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":5003,"cache_read_input_tokens":544264,"cache_creation_input_tokens":220,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":220},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"apiBlockIndex":1,"requestId":"req_011CfuBajH8R5CBq5BdUxfMr","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"e4671a74-5e61-4f56-aa34-17f72e364e36","timestamp":"2026-10-10T20:25:28.010Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"53e0d48f-0e86-4176-8390-70cad3fe3f46","userType":"external","entrypoint":"cli","cwd":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026","sessionId":"7fd52f13-5d0c-4e7f-8ec6-8a947b2499a1","version":"2.1.296","gitBranch":"main","slug":"federated-petting-ripple"}
{"parentUuid":"e4671a74-5e61-4f56-aa34-17f72e364e36","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfuBajfTHQPS5YR5tnfo8","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AbTeUTHmRsCr1mik2bnx7N","name":"Write","input":{"file_path":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/lib/pipeline/scoring.ts","content":"/* Dixi score for a feature request (0–100) with decision memory.\n *\n *   base   = weighted mean of  demand · market backing · principle fit\n *   memory = past decisions on the same request (same series), from earlier generations:\n *            rejected → penalty that fades with a half-life, lifted when demand has grown enough since (\"resurfaced\")\n *            kept     → small bonus that fades the same way\n *   score  = base × (1 − penalty) + bonus\n *\n * Settings are tuned by the team in /dashboard/settings and stored in this browser for now (Supabase later).\n * The backend agent will apply the same rules before it proposes requests (see docs/architecture/09-scoring-and-memory.md).\n */\nimport { useSyncExternalStore } from \"react\";\nimport type { MarketScope } from \"@/lib/dashboard-data\";\nimport type { Decision } from \"./profiles\";\nimport type { Session } from \"./sessions\";\nimport type { Category, FeatureRequest, SeriesId } from \"./types\";\n\nexport interface ScoringSettings {\n  /** Relative weights of the three base parts (normalised). */\n  wDemand: number;\n  wBacking: number;\n  wFit: number;\n  /** How much a past reject lowers the score at full strength (0–1). */\n  rejectPenalty: number;\n  /** Bonus for requests kept before (0–1, of 10 points). */\n  keepBonus: number;\n  /** After this many days a past decision counts half. */\n  halfLifeDays: number;\n  /** Demand growth since the reject that brings a request back (0.3 = +30 %). */\n  resurfaceAt: number;\n  /** Hide previously rejected requests instead of only ranking them lower. */\n  hideRejected: boolean;\n  /** Use memory from every market, or only from the same market. */\n  memoryScope: \"market\" | \"all\";\n}\n\nexport const DEFAULT_SCORING: ScoringSettings = {\n  wDemand: 0.6,\n  wBacking: 0.25,\n  wFit: 0.15,\n  rejectPenalty: 0.6,\n  keepBonus: 0.5,\n  halfLifeDays: 365,\n  resurfaceAt: 0.3,\n  hideRejected: false,\n  memoryScope: \"market\",\n};\n\n/* ---------- settings store (localStorage, reactive) ---------- */\n\nconst KEY = \"dixi:scoring\";\nconst EVENT = \"dixi:scoring\";\nlet cacheRaw: string | null | undefined;\nlet cache: ScoringSettings = DEFAULT_SCORING;\n\nfunction read(): ScoringSettings {\n  let raw: string | null = null;\n  try {\n    raw = localStorage.getItem(KEY);\n  } catch {\n    /* storage blocked */\n  }\n  if (raw !== cacheRaw) {\n    cacheRaw = raw;\n    try {\n      cache = { ...DEFAULT_SCORING, ...(raw ? (JSON.parse(raw) as Partial<ScoringSettings>) : {}) };\n    } catch {\n      cache = DEFAULT_SCORING;\n    }\n  }\n  return cache;\n}\n\nexport function saveScoring(s: ScoringSettings) {\n  try {\n    localStorage.setItem(KEY, JSON.stringify(s));\n  } catch {\n    /* storage blocked */\n  }\n  window.dispatchEvent(new Event(EVENT));\n}\n\nfunction subscribe(cb: () => void) {\n  window.addEventListener(EVENT, cb);\n  window.addEventListener(\"storage\", cb);\n  return () => {\n    window.removeEventListener(EVENT, cb);\n    window.removeEventListener(\"storage\", cb);\n  };\n}\n\nexport const useScoring = () => useSyncExternalStore(subscribe, read, () => DEFAULT_SCORING);\n\n/* ---------- decision memory ---------- */\n\nexport interface MemoryEntry {\n  action: \"keep\" | \"reject\";\n  reason?: string;\n  by: string;\n  role?: string;\n  at: string;\n  /** Mentions when the decision was made (to detect growing demand). */\n  mentionsAt?: number;\n  generationId: string;\n  scopeLabel: string;\n}\n\n/** Key that stays stable across data rebuilds: series + request title. */\nexport const memoryKey = (series: SeriesId, title: string) => `${series}:${title.toLowerCase()}`;\n\n/** Latest keep/reject per request from earlier generations of this series (and market, unless scope is \"all\"). */\nexport function buildMemory(generations: Session[], series: SeriesId, scope: MarketScope, settings: ScoringSettings): Map<string, MemoryEntry> {\n  const mem = new Map<string, MemoryEntry>();\n  const relevant = generations\n    .filter((g) => g.series === series && (settings.memoryScope === \"all\" || g.scope === scope))\n    .sort((a, b) => a.createdAt.localeCompare(b.createdAt));\n  for (const g of relevant) {\n    for (const d of Object.values(g.decisions) as Decision[]) {\n      if (d.action !== \"keep\" && d.action !== \"reject\") continue;\n      const k = memoryKey(series, d.title);\n      const prev = mem.get(k);\n      if (!prev || prev.at <= d.at)\n        mem.set(k, { action: d.action, reason: d.reason, by: d.by, role: d.role, at: d.at, mentionsAt: d.mentionsAt, generationId: g.id, scopeLabel: g.scopeLabel });\n    }\n  }\n  return mem;\n}\n\n/* ---------- the score ---------- */\n\nexport type MemoryState = \"rejected\" | \"resurfaced\" | \"kept\" | null;\n\nexport interface Scored {\n  score: number;\n  base: number;\n  parts: { demand: number; backing: number; fit: number };\n  memory: MemoryEntry | null;\n  state: MemoryState;\n  /** 0–1: how much of the penalty or bonus still applies after the half-life decay. */\n  strength: number;\n  /** Demand growth since the past decision (null when unknown). */\n  growth: number | null;\n  hidden: boolean;\n}\n\nexport function scoreRequest(\n  req: FeatureRequest,\n  scoped: number,\n  maxScoped: number,\n  backingCount: number,\n  focus: Category[],\n  memory: Map<string, MemoryEntry>,\n  s: ScoringSettings,\n  now = Date.now(),\n): Scored {\n  const demand = maxScoped > 0 ? Math.log1p(scoped) / Math.log1p(maxScoped) : 0;\n  const backing = Math.min(1, backingCount / 2);\n  const fit = focus.includes(req.category) ? 1 : 0.4;\n  const wSum = s.wDemand + s.wBacking + s.wFit || 1;\n  const base = (100 * (s.wDemand * demand + s.wBacking * backing + s.wFit * fit)) / wSum;\n\n  const m = memory.get(memoryKey(req.series, req.title)) ?? null;\n  let state: MemoryState = null;\n  let strength = 0;\n  let growth: number | null = null;\n  let score = base;\n  if (m) {\n    const days = Math.max(0, (now - Date.parse(m.at)) / 86_400_000);\n    strength = Math.pow(0.5, days / Math.max(1, s.halfLifeDays));\n    growth = m.mentionsAt ? (scoped - m.mentionsAt) / m.mentionsAt : null;\n    if (m.action === \"reject\") {\n      const resurfaced = growth !== null && growth >= s.resurfaceAt;\n      state = resurfaced ? \"resurfaced\" : \"rejected\";\n      if (!resurfaced) score = base * (1 - s.rejectPenalty * strength);\n    } else {\n      state = \"kept\";\n      score = Math.min(100, base + 10 * s.keepBonus * strength);\n    }\n  }\n  return {\n    score: Math.round(score),\n    base: Math.round(base),\n    parts: { demand, backing, fit },\n    memory: m,\n    state,\n    strength,\n    growth,\n    hidden: s.hideRejected && state === \"rejected\",\n  };\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":220,"cache_read_input_tokens":544264,"output_tokens":5003,"output_tokens_details":{"thinking_tokens":1932},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":220,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":5003,"cache_read_input_tokens":544264,"cache_creation_input_tokens":220,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":220},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01AbTeUTHmRsCr1mik2bnx7N":{"file_path":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/lib/pipeline/scoring.ts","content":"/* Dixi score for a feature request (0–100) with decision memory.\n *\n *   base   = weighted mean of  demand · market backing · principle fit\n *   memory = past decisions on the same request (same series), from earlier generations:\n *            rejected → penalty that fades with a half-life, lifted when demand has grown enough since (\"resurfaced\")\n *            kept     → small bonus that fades the same way\n *   score  = base × (1 − penalty) + bonus\n *\n * Settings are tuned by the team in /dashboard/settings and stored in this browser for now (Supabase later).\n * The backend agent will apply the same rules before it proposes requests (see docs/architecture/09-scoring-and-memory.md).\n */\nimport { useSyncExternalStore } from \"react\";\nimport type { MarketScope } from \"@/lib/dashboard-data\";\nimport type { Decision } from \"./profiles\";\nimport type { Session } from \"./sessions\";\nimport type { Category, FeatureRequest, SeriesId } from \"./types\";\n\nexport interface ScoringSettings {\n  /** Relative weights of the three base parts (normalised). */\n  wDemand: number;\n  wBacking: number;\n  wFit: number;\n  /** How much a past reject lowers the score at full strength (0–1). */\n  rejectPenalty: number;\n  /** Bonus for requests kept before (0–1, of 10 points). */\n  keepBonus: number;\n  /** After this many days a past decision counts half. */\n  halfLifeDays: number;\n  /** Demand growth since the reject that brings a request back (0.3 = +30 %). */\n  resurfaceAt: number;\n  /** Hide previously rejected requests instead of only ranking them lower. */\n  hideRejected: boolean;\n  /** Use memory from every market, or only from the same market. */\n  memoryScope: \"market\" | \"all\";\n}\n\nexport const DEFAULT_SCORING: ScoringSettings = {\n  wDemand: 0.6,\n  wBacking: 0.25,\n  wFit: 0.15,\n  rejectPenalty: 0.6,\n  keepBonus: 0.5,\n  halfLifeDays: 365,\n  resurfaceAt: 0.3,\n  hideRejected: false,\n  memoryScope: \"market\",\n};\n\n/* ---------- settings store (localStorage, reactive) ---------- */\n\nconst KEY = \"dixi:scoring\";\nconst EVENT = \"dixi:scoring\";\nlet cacheRaw: string | null | undefined;\nlet cache: ScoringSettings = DEFAULT_SCORING;\n\nfunction read(): ScoringSettings {\n  let raw: string | null = null;\n  try {\n    raw = localStorage.getItem(KEY);\n  } catch {\n    /* storage blocked */\n  }\n  if (raw !== cacheRaw) {\n    cacheRaw = raw;\n    try {\n      cache = { ...DEFAULT_SCORING, ...(raw ? (JSON.parse(raw) as Partial<ScoringSettings>) : {}) };\n    } catch {\n      cache = DEFAULT_SCORING;\n    }\n  }\n  return cache;\n}\n\nexport function saveScoring(s: ScoringSettings) {\n  try {\n    localStorage.setItem(KEY, JSON.stringify(s));\n  } catch {\n    /* storage blocked */\n  }\n  window.dispatchEvent(new Event(EVENT));\n}\n\nfunction subscribe(cb: () => void) {\n  window.addEventListener(EVENT, cb);\n  window.addEventListener(\"storage\", cb);\n  return () => {\n    window.removeEventListener(EVENT, cb);\n    window.removeEventListener(\"storage\", cb);\n  };\n}\n\nexport const useScoring = () => useSyncExternalStore(subscribe, read, () => DEFAULT_SCORING);\n\n/* ---------- decision memory ---------- */\n\nexport interface MemoryEntry {\n  action: \"keep\" | \"reject\";\n  reason?: string;\n  by: string;\n  role?: string;\n  at: string;\n  /** Mentions when the decision was made (to detect growing demand). */\n  mentionsAt?: number;\n  generationId: string;\n  scopeLabel: string;\n}\n\n/** Key that stays stable across data rebuilds: series + request title. */\nexport const memoryKey = (series: SeriesId, title: string) => `${series}:${title.toLowerCase()}`;\n\n/** Latest keep/reject per request from earlier generations of this series (and market, unless scope is \"all\"). */\nexport function buildMemory(generations: Session[], series: SeriesId, scope: MarketScope, settings: ScoringSettings): Map<string, MemoryEntry> {\n  const mem = new Map<string, MemoryEntry>();\n  const relevant = generations\n    .filter((g) => g.series === series && (settings.memoryScope === \"all\" || g.scope === scope))\n    .sort((a, b) => a.createdAt.localeCompare(b.createdAt));\n  for (const g of relevant) {\n    for (const d of Object.values(g.decisions) as Decision[]) {\n      if (d.action !== \"keep\" && d.action !== \"reject\") continue;\n      const k = memoryKey(series, d.title);\n      const prev = mem.get(k);\n      if (!prev || prev.at <= d.at)\n        mem.set(k, { action: d.action, reason: d.reason, by: d.by, role: d.role, at: d.at, mentionsAt: d.mentionsAt, generationId: g.id, scopeLabel: g.scopeLabel });\n    }\n  }\n  return mem;\n}\n\n/* ---------- the score ---------- */\n\nexport type MemoryState = \"rejected\" | \"resurfaced\" | \"kept\" | null;\n\nexport interface Scored {\n  score: number;\n  base: number;\n  parts: { demand: number; backing: number; fit: number };\n  memory: MemoryEntry | null;\n  state: MemoryState;\n  /** 0–1: how much of the penalty or bonus still applies after the half-life decay. */\n  strength: number;\n  /** Demand growth since the past decision (null when unknown). */\n  growth: number | null;\n  hidden: boolean;\n}\n\nexport function scoreRequest(\n  req: FeatureRequest,\n  scoped: number,\n  maxScoped: number,\n  backingCount: number,\n  focus: Category[],\n  memory: Map<string, MemoryEntry>,\n  s: ScoringSettings,\n  now = Date.now(),\n): Scored {\n  const demand = maxScoped > 0 ? Math.log1p(scoped) / Math.log1p(maxScoped) : 0;\n  const backing = Math.min(1, backingCount / 2);\n  const fit = focus.includes(req.category) ? 1 : 0.4;\n  const wSum = s.wDemand + s.wBacking + s.wFit || 1;\n  const base = (100 * (s.wDemand * demand + s.wBacking * backing + s.wFit * fit)) / wSum;\n\n  const m = memory.get(memoryKey(req.series, req.title)) ?? null;\n  let state: MemoryState = null;\n  let strength = 0;\n  let growth: number | null = null;\n  let score = base;\n  if (m) {\n    const days = Math.max(0, (now - Date.parse(m.at)) / 86_400_000);\n    strength = Math.pow(0.5, days / Math.max(1, s.halfLifeDays));\n    growth = m.mentionsAt ? (scoped - m.mentionsAt) / m.mentionsAt : null;\n    if (m.action === \"reject\") {\n      const resurfaced = growth !== null && growth >= s.resurfaceAt;\n      state = resurfaced ? \"resurfaced\" : \"rejected\";\n      if (!resurfaced) score = base * (1 - s.rejectPenalty * strength);\n    } else {\n      state = \"kept\";\n      score = Math.min(100, base + 10 * s.keepBonus * strength);\n    }\n  }\n  return {\n    score: Math.round(score),\n    base: Math.round(base),\n    parts: { demand, backing, fit },\n    memory: m,\n    state,\n    strength,\n    growth,\n    hidden: s.hideRejected && state === \"rejected\",\n  };\n}\n"}},"apiBlockIndex":2,"requestId":"req_011CfuBajH8R5CBq5BdUxfMr","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"5c217c4b-0bb6-4fc7-a374-f28e753e6f73","timestamp":"2026-10-10T20:25:49.191Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"53e0d48f-0e86-4176-8390-70cad3fe3f46","userType":"external","entrypoint":"cli","cwd":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026","sessionId":"7fd52f13-5d0c-4e7f-8ec6-8a947b2499a1","version":"2.1.296","gitBranch":"main","slug":"federated-petting-ripple"}
{"parentUuid":"5c217c4b-0bb6-4fc7-a374-f28e753e6f73","isSidechain":false,"promptId":"55e0a9c9-5e46-447d-bd51-556d6261cceb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AbTeUTHmRsCr1mik2bnx7N","type":"tool_result","content":"File created successfully at: /Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/lib/pipeline/scoring.ts (file state is current in your context — no need to Read it back)"}]},"uuid":"9983d112-7817-4ae0-bba1-e799e748a871","timestamp":"2026-10-10T20:25:49.230Z","toolUseResult":{"type":"create","filePath":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/lib/pipeline/scoring.ts","content":"/* Dixi score for a feature request (0–100) with decision memory.\n *\n *   base   = weighted mean of  demand · market backing · principle fit\n *   memory = past decisions on the same request (same series), from earlier generations:\n *            rejected → penalty that fades with a half-life, lifted when demand has grown enough since (\"resurfaced\")\n *            kept     → small bonus that fades the same way\n *   score  = base × (1 − penalty) + bonus\n *\n * Settings are tuned by the team in /dashboard/settings and stored in this browser for now (Supabase later).\n * The backend agent will apply the same rules before it proposes requests (see docs/architecture/09-scoring-and-memory.md).\n */\nimport { useSyncExternalStore } from \"react\";\nimport type { MarketScope } from \"@/lib/dashboard-data\";\nimport type { Decision } from \"./profiles\";\nimport type { Session } from \"./sessions\";\nimport type { Category, FeatureRequest, SeriesId } from \"./types\";\n\nexport interface ScoringSettings {\n  /** Relative weights of the three base parts (normalised). */\n  wDemand: number;\n  wBacking: number;\n  wFit: number;\n  /** How much a past reject lowers the score at full strength (0–1). */\n  rejectPenalty: number;\n  /** Bonus for requests kept before (0–1, of 10 points). */\n  keepBonus: number;\n  /** After this many days a past decision counts half. */\n  halfLifeDays: number;\n  /** Demand growth since the reject that brings a request back (0.3 = +30 %). */\n  resurfaceAt: number;\n  /** Hide previously rejected requests instead of only ranking them lower. */\n  hideRejected: boolean;\n  /** Use memory from every market, or only from the same market. */\n  memoryScope: \"market\" | \"all\";\n}\n\nexport const DEFAULT_SCORING: ScoringSettings = {\n  wDemand: 0.6,\n  wBacking: 0.25,\n  wFit: 0.15,\n  rejectPenalty: 0.6,\n  keepBonus: 0.5,\n  halfLifeDays: 365,\n  resurfaceAt: 0.3,\n  hideRejected: false,\n  memoryScope: \"market\",\n};\n\n/* ---------- settings store (localStorage, reactive) ---------- */\n\nconst KEY = \"dixi:scoring\";\nconst EVENT = \"dixi:scoring\";\nlet cacheRaw: string | null | undefined;\nlet cache: ScoringSettings = DEFAULT_SCORING;\n\nfunction read(): ScoringSettings {\n  let raw: string | null = null;\n  try {\n    raw = localStorage.getItem(KEY);\n  } catch {\n    /* storage blocked */\n  }\n  if (raw !== cacheRaw) {\n    cacheRaw = raw;\n    try {\n      cache = { ...DEFAULT_SCORING, ...(raw ? (JSON.parse(raw) as Partial<ScoringSettings>) : {}) };\n    } catch {\n      cache = DEFAULT_SCORING;\n    }\n  }\n  return cache;\n}\n\nexport function saveScoring(s: ScoringSettings) {\n  try {\n    localStorage.setItem(KEY, JSON.stringify(s));\n  } catch {\n    /* storage blocked */\n  }\n  window.dispatchEvent(new Event(EVENT));\n}\n\nfunction subscribe(cb: () => void) {\n  window.addEventListener(EVENT, cb);\n  window.addEventListener(\"storage\", cb);\n  return () => {\n    window.removeEventListener(EVENT, cb);\n    window.removeEventListener(\"storage\", cb);\n  };\n}\n\nexport const useScoring = () => useSyncExternalStore(subscribe, read, () => DEFAULT_SCORING);\n\n/* ---------- decision memory ---------- */\n\nexport interface MemoryEntry {\n  action: \"keep\" | \"reject\";\n  reason?: string;\n  by: string;\n  role?: string;\n  at: string;\n  /** Mentions when the decision was made (to detect growing demand). */\n  mentionsAt?: number;\n  generationId: string;\n  scopeLabel: string;\n}\n\n/** Key that stays stable across data rebuilds: series + request title. */\nexport const memoryKey = (series: SeriesId, title: string) => `${series}:${title.toLowerCase()}`;\n\n/** Latest keep/reject per request from earlier generations of this series (and market, unless scope is \"all\"). */\nexport function buildMemory(generations: Session[], series: SeriesId, scope: MarketScope, settings: ScoringSettings): Map<string, MemoryEntry> {\n  const mem = new Map<string, MemoryEntry>();\n  const relevant = generations\n    .filter((g) => g.series === series && (settings.memoryScope === \"all\" || g.scope === scope))\n    .sort((a, b) => a.createdAt.localeCompare(b.createdAt));\n  for (const g of relevant) {\n    for (const d of Object.values(g.decisions) as Decision[]) {\n      if (d.action !== \"keep\" && d.action !== \"reject\") continue;\n      const k = memoryKey(series, d.title);\n      const prev = mem.get(k);\n      if (!prev || prev.at <= d.at)\n        mem.set(k, { action: d.action, reason: d.reason, by: d.by, role: d.role, at: d.at, mentionsAt: d.mentionsAt, generationId: g.id, scopeLabel: g.scopeLabel });\n    }\n  }\n  return mem;\n}\n\n/* ---------- the score ---------- */\n\nexport type MemoryState = \"rejected\" | \"resurfaced\" | \"kept\" | null;\n\nexport interface Scored {\n  score: number;\n  base: number;\n  parts: { demand: number; backing: number; fit: number };\n  memory: MemoryEntry | null;\n  state: MemoryState;\n  /** 0–1: how much of the penalty or bonus still applies after the half-life decay. */\n  strength: number;\n  /** Demand growth since the past decision (null when unknown). */\n  growth: number | null;\n  hidden: boolean;\n}\n\nexport function scoreRequest(\n  req: FeatureRequest,\n  scoped: number,\n  maxScoped: number,\n  backingCount: number,\n  focus: Category[],\n  memory: Map<string, MemoryEntry>,\n  s: ScoringSettings,\n  now = Date.now(),\n): Scored {\n  const demand = maxScoped > 0 ? Math.log1p(scoped) / Math.log1p(maxScoped) : 0;\n  const backing = Math.min(1, backingCount / 2);\n  const fit = focus.includes(req.category) ? 1 : 0.4;\n  const wSum = s.wDemand + s.wBacking + s.wFit || 1;\n  const base = (100 * (s.wDemand * demand + s.wBacking * backing + s.wFit * fit)) / wSum;\n\n  const m = memory.get(memoryKey(req.series, req.title)) ?? null;\n  let state: MemoryState = null;\n  let strength = 0;\n  let growth: number | null = null;\n  let score = base;\n  if (m) {\n    const days = Math.max(0, (now - Date.parse(m.at)) / 86_400_000);\n    strength = Math.pow(0.5, days / Math.max(1, s.halfLifeDays));\n    growth = m.mentionsAt ? (scoped - m.mentionsAt) / m.mentionsAt : null;\n    if (m.action === \"reject\") {\n      const resurfaced = growth !== null && growth >= s.resurfaceAt;\n      state = resurfaced ? \"resurfaced\" : \"rejected\";\n      if (!resurfaced) score = base * (1 - s.rejectPenalty * strength);\n    } else {\n      state = \"kept\";\n      score = Math.min(100, base + 10 * s.keepBonus * strength);\n    }\n  }\n  return {\n    score: Math.round(score),\n    base: Math.round(base),\n    parts: { demand, backing, fit },\n    memory: m,\n    state,\n    strength,\n    growth,\n    hidden: s.hideRejected && state === \"rejected\",\n  };\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"5c217c4b-0bb6-4fc7-a374-f28e753e6f73","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"53e0d48f-0e86-4176-8390-70cad3fe3f46","userType":"external","entrypoint":"cli","cwd":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026","sessionId":"7fd52f13-5d0c-4e7f-8ec6-8a947b2499a1","version":"2.1.296","gitBranch":"main","slug":"federated-petting-ripple"}
