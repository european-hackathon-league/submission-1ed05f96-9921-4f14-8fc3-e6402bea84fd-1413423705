{"parentUuid":"b50ad695-79b1-4a00-a31f-3d4ea101d1af","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfuAPeLJ2F7QAgsePFDgg","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":240,"cache_read_input_tokens":443232,"output_tokens":9744,"output_tokens_details":{"thinking_tokens":18},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":240,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":9744,"cache_read_input_tokens":443232,"cache_creation_input_tokens":240,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":240},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":524,"thinkingDisplay":"updates","apiBlockIndex":0,"requestId":"req_011CfuAPdwVb15cPNqkt5i6s","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"84de5f93-b149-46e1-a22e-f8bc0ede2cf1","timestamp":"2026-10-10T20:09:28.856Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"53e0d48f-0e86-4176-8390-70cad3fe3f46","userType":"external","entrypoint":"cli","cwd":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web","sessionId":"7fd52f13-5d0c-4e7f-8ec6-8a947b2499a1","version":"2.1.296","gitBranch":"main","slug":"federated-petting-ripple"}
{"parentUuid":"84de5f93-b149-46e1-a22e-f8bc0ede2cf1","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfuAPeLJ2F7QAgsePFDgg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01C5sXghMezxCtyHVeimiaEE","name":"Write","input":{"file_path":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/pipeline/Profiles.tsx","content":"\"use client\";\n\nimport Image from \"next/image\";\nimport { ArrowLeft, ArrowRight, Download, ExternalLink, Star, Trophy } from \"lucide-react\";\nimport type { CarImage } from \"@/lib/car-images\";\nimport { draftTarget, type Decisions, type Profile } from \"@/lib/pipeline/profiles\";\nimport type { SeriesConfig } from \"@/lib/pipeline/series\";\nimport type { Session } from \"@/lib/pipeline/sessions\";\nimport { CATEGORIES, type FeatureRequest, type MarketSignal } from \"@/lib/pipeline/types\";\nimport { PROFILE_COLOR } from \"./Analytics\";\nimport { CATEGORY_ICON, SIGNAL_ICON } from \"./icons\";\n\nconst layerParts = (score: Profile[\"score\"], l3Weight: number) => {\n  const w3 = score.l3 === null ? 0 : l3Weight;\n  const w1 = 0.45 * (1 - w3);\n  const w2 = 1 - w1 - w3;\n  return [\n    { id: \"L1\", cls: \"bg-l1\", v: w1 * score.l1, label: \"principles\" },\n    { id: \"L2\", cls: \"bg-l2\", v: w2 * score.l2, label: \"evidence\" },\n    { id: \"L3\", cls: \"bg-l3\", v: w3 * (score.l3 ?? 0), label: \"social test\" },\n  ];\n};\n\n/** Stacked bar: how much each layer contributes to a profile's score. */\nexport function LayerScore({ score, l3Weight, dark }: { score: Profile[\"score\"]; l3Weight: number; dark?: boolean }) {\n  const parts = layerParts(score, l3Weight);\n  const pct = Math.round(score.total * 100);\n  return (\n    <div className=\"flex items-center gap-3\">\n      <div\n        role=\"img\"\n        aria-label={`Score ${pct} of 100: ${parts.map((p) => `${p.label} ${Math.round(p.v * 100)}`).join(\", \")}`}\n        className={`flex h-2 flex-1 overflow-hidden rounded-full ${dark ? \"bg-white/10\" : \"bg-bg-soft ring-1 ring-inset ring-line\"}`}\n      >\n        {parts.map((p) => (\n          <span key={p.id} className={`h-full ${dark && p.id === \"L1\" ? \"bg-brand-sky\" : p.cls}`} style={{ width: `${p.v * 100}%` }} />\n        ))}\n      </div>\n      <span aria-hidden className={`w-7 text-right text-sm font-semibold tabular-nums ${dark ? \"text-white\" : \"text-ink\"}`}>\n        {pct}\n      </span>\n    </div>\n  );\n}\n\nconst letter = (i: number) => String.fromCharCode(65 + i);\nconst capitalise = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);\n/** Price in the option-list style: 1.900,– */\nconst listPrice = (n: number | null) => (n === null ? \"–,–\" : `${n.toLocaleString(\"de-DE\")},–`);\n\n/* ---------- dashboard cards ---------- */\n\nexport function ProfileList({ profiles, cfg, image, onOpen }: { profiles: Profile[]; cfg: SeriesConfig; image?: CarImage; onOpen: (id: string) => void }) {\n  return (\n    <ul className=\"grid gap-5 lg:grid-cols-3\">\n      {profiles.map((p, i) => {\n        const color = PROFILE_COLOR[p.id];\n        return (\n          <li key={p.id}>\n            <button\n              type=\"button\"\n              onClick={() => onOpen(p.id)}\n              className=\"group flex h-full w-full flex-col overflow-hidden rounded-[22px] bg-ink text-left text-white shadow-card ring-1 ring-line transition-[box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-float motion-reduce:transition-none motion-reduce:hover:translate-y-0\"\n            >\n              <div className=\"relative aspect-[16/9] overflow-hidden\">\n                {image && (\n                  <Image\n                    src={image.src}\n                    alt=\"\"\n                    fill\n                    sizes=\"(min-width: 1024px) 30vw, 100vw\"\n                    className=\"object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none\"\n                  />\n                )}\n                {/* tint the photo in the profile's colour, then fade into the card */}\n                <div aria-hidden className=\"absolute inset-0 opacity-35 mix-blend-color\" style={{ backgroundColor: color.stroke }} />\n                <div aria-hidden className=\"absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink to-transparent\" />\n                <span className=\"absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-2.5 py-1 text-xs font-semibold tracking-wider ring-1 ring-white/20 backdrop-blur-md\">\n                  <span aria-hidden className=\"size-2 rounded-full\" style={{ backgroundColor: color.stroke }} />\n                  PROFILE {letter(i)}\n                </span>\n                {i === 0 && (\n                  <span className=\"absolute right-4 top-4 inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-ink\">\n                    <Trophy aria-hidden className=\"size-3.5 text-brand\" /> Best fit\n                  </span>\n                )}\n              </div>\n\n              <div className=\"-mt-4 flex flex-1 flex-col gap-4 p-5 pt-0\">\n                <div className=\"relative\">\n                  <h3 className=\"text-2xl font-semibold tracking-tight\">{p.name}</h3>\n                  <p className=\"text-sm text-white/65\">{p.tagline}</p>\n                </div>\n                <LayerScore score={p.score} l3Weight={cfg.l3Weight} dark />\n                <ul className=\"flex flex-col gap-2 text-sm\">\n                  {p.requests.slice(0, 4).map((r) => {\n                    const Icon = CATEGORY_ICON[r.category];\n                    return (\n                      <li key={r.id} className=\"flex items-center gap-2.5\">\n                        <span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-white/10\">\n                          <Icon aria-hidden className=\"size-3.5 text-brand-sky\" />\n                        </span>\n                        <span className=\"min-w-0 flex-1 truncate text-white/85\">{r.title}</span>\n                        <span className=\"shrink-0 text-xs tabular-nums text-white/45\">#{r.priority}</span>\n                      </li>\n                    );\n                  })}\n                  {p.wishes.map((w) => (\n                    <li key={w.id} className=\"flex items-center gap-2.5\">\n                      <span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-white/10\">\n                        <Star aria-hidden className=\"size-3.5 text-brand-sky\" fill=\"currentColor\" />\n                      </span>\n                      <span className=\"min-w-0 flex-1 truncate text-white/85\">{w.title}</span>\n                    </li>\n                  ))}\n                </ul>\n                <span className=\"mt-auto inline-flex h-10 items-center justify-between rounded-full bg-white px-4 text-sm font-medium text-ink transition-colors group-hover:bg-brand group-hover:text-white\">\n                  Open profile\n                  <ArrowRight aria-hidden className=\"size-4 transition-transform group-hover:translate-x-0.5\" />\n                </span>\n              </div>\n            </button>\n          </li>\n        );\n      })}\n    </ul>\n  );\n}\n\n/* ---------- profile page: laid out like BMW's option-list catalogue ---------- */\n\nexport function ProfileDetail({\n  profile,\n  profiles,\n  rank,\n  cfg,\n  scopeLabel,\n  decisions,\n  session,\n  image,\n  onBack,\n}: {\n  profile: Profile;\n  /** All profiles of the session, for the comparison columns. */\n  profiles: Profile[];\n  rank: number;\n  cfg: SeriesConfig;\n  scopeLabel: string;\n  decisions: Decisions;\n  session: Session;\n  image?: CarImage;\n  onBack: () => void;\n}) {\n  const color = PROFILE_COLOR[profile.id];\n  const included = new Set(profile.requests.map((r) => r.id));\n  const all = Object.values(decisions);\n  const rejected = all.filter((d) => d.action === \"reject\");\n  const keptOut = all.filter((d) => d.action === \"keep\" && !included.has(d.requestId));\n\n  /* Every requirement of the session, so the matrix compares this profile with the others. */\n  const union = new Map<string, FeatureRequest & { scoped: number; priority: number }>();\n  profiles.forEach((p) => p.requests.forEach((r) => union.set(r.id, r)));\n  const rows = [...union.values()].sort((a, b) => a.priority - b.priority);\n  const wishes = new Map<string, MarketSignal>();\n  profiles.forEach((p) => p.wishes.forEach((w) => wishes.set(w.id, w)));\n\n  const options = profile.requests.flatMap((r) => r.relatedOptions);\n  const optionTotal = options.reduce((s, o) => s + (o.priceEur ?? 0), 0);\n  const covered = profile.requests.reduce((s, r) => s + r.scoped, 0);\n  const signals = [...profile.wishes.map((s) => ({ s, wish: true })), ...profile.backing.filter((b) => !profile.wishes.includes(b)).map((s) => ({ s, wish: false }))];\n  const date = new Date(session.createdAt).toLocaleDateString(\"en-GB\", { month: \"long\", year: \"numeric\" }).toUpperCase();\n  const seriesNo = cfg.name.split(\" \")[0];\n\n  const mark = (p: Profile, id: string, isWish = false) => {\n    const has = isWish ? p.wishes.some((w) => w.id === id) : p.requests.some((r) => r.id === id);\n    if (!has) return <span className=\"text-line\">–</span>;\n    return p.id === profile.id ? <span title=\"In this profile\">■</span> : <span title=\"In another profile\" className=\"text-muted\">□</span>;\n  };\n\n  return (\n    <div className=\"flex flex-col gap-5\">\n      <div data-no-print className=\"flex items-center justify-between gap-3\">\n        <button type=\"button\" onClick={onBack} className=\"inline-flex items-center gap-1.5 text-sm text-muted hover:text-brand\">\n          <ArrowLeft aria-hidden className=\"size-4\" /> All profiles\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => window.print()}\n          title=\"Opens the print dialog: choose “Save as PDF”\"\n          className=\"inline-flex h-10 items-center gap-2 rounded-full bg-ink px-4 text-sm font-medium text-white shadow-card transition-colors hover:bg-brand-deep\"\n        >\n          <Download aria-hidden className=\"size-4\" /> Download PDF\n        </button>\n      </div>\n\n      <article data-print-root className=\"flex flex-col gap-12 rounded-[22px] border border-line bg-surface pb-10 shadow-card print:border-0\">\n        {/* Cover */}\n        <header className=\"relative isolate min-h-[440px] overflow-hidden rounded-t-[22px] bg-ink text-white\">\n          {image && <Image src={image.src} alt={image.alt} fill loading=\"eager\" sizes=\"(min-width: 1024px) 70vw, 100vw\" className=\"-z-10 object-cover\" />}\n          <div aria-hidden className=\"absolute inset-0 -z-10 bg-gradient-to-r from-ink/85 via-ink/30 to-transparent\" />\n          <div aria-hidden className=\"absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-ink/80 to-transparent\" />\n          <div className=\"flex min-h-[440px] flex-col justify-between p-8 sm:p-10\">\n            <div>\n              <p className=\"text-6xl font-light tracking-tight sm:text-7xl\">BMW {seriesNo}</p>\n              <p className=\"mt-2 text-sm font-semibold uppercase tracking-[0.3em] text-white/80\">\n                Profile {letter(rank)} · {profile.name}\n              </p>\n              <p className=\"mt-4 max-w-sm text-white/75\">{profile.tagline}</p>\n            </div>\n            <div className=\"flex flex-wrap items-end justify-between gap-4 text-xs\">\n              <div className=\"flex flex-col gap-1\">\n                <span className=\"inline-flex items-center gap-2 font-semibold uppercase tracking-[0.2em]\">\n                  <span aria-hidden className=\"size-2.5 rounded-full\" style={{ backgroundColor: color.stroke }} />\n                  {scopeLabel} · {date}\n                </span>\n                <span className=\"text-white/55\">Dixi requirement profile · Session {session.id}</span>\n              </div>\n              {image && (\n                <a href={image.page} target=\"_blank\" rel=\"noreferrer\" className=\"text-white/50 hover:text-white hover:underline\">\n                  {image.credit} · modified\n                </a>\n              )}\n            </div>\n          </div>\n        </header>\n\n        <div className=\"flex flex-col gap-12 px-6 sm:px-10\">\n          {/* At a glance: like \"Fahrzeugpreise\" */}\n          <CatalogSection title=\"Profile at a glance\">\n            <div className=\"grid gap-8 md:grid-cols-2\">\n              <table className=\"w-full text-[13px]\">\n                <Band cols={2}>Score</Band>\n                <tbody>\n                  <Row label=\"L1 · Principles and your priority\" value={Math.round(profile.score.l1 * 100)} />\n                  <Row label=\"L2 · Evidence covered\" value={Math.round(profile.score.l2 * 100)} />\n                  <Row label={`L3 · Social test (max ${Math.round(cfg.l3Weight * 100)}%)`} value={profile.score.l3 === null ? \"not run\" : Math.round(profile.score.l3 * 100)} />\n                  <Row label=\"Total score\" value={Math.round(profile.score.total * 100)} strong />\n                </tbody>\n              </table>\n              <table className=\"w-full text-[13px]\">\n                <Band cols={2}>Scope</Band>\n                <tbody>\n                  <Row label=\"Series · market\" value={`${cfg.name} (${cfg.id}) · ${scopeLabel}`} />\n                  <Row label=\"Requirements\" value={profile.requests.length} />\n                  <Row label=\"Customer mentions covered\" value={covered.toLocaleString(\"en\")} />\n                  <Row label=\"From the wishlist\" value={profile.wishes.length} />\n                  <Row label=\"Related options today (EUR incl. VAT)\" value={listPrice(optionTotal || null)} strong />\n                </tbody>\n              </table>\n            </div>\n          </CatalogSection>\n\n          {/* Requirements matrix: like \"Sonderausstattungen\" */}\n          <CatalogSection title=\"Requirements\" note=\"In your priority order. Columns compare the three profiles of this session.\">\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full min-w-[640px] text-[13px]\">\n                <thead>\n                  <tr className=\"align-bottom text-[11px] text-muted\">\n                    <th className=\"pb-2 text-left font-normal\" />\n                    <th className=\"w-16 pb-2 text-left font-normal\">Code</th>\n                    <th className=\"w-28 pb-2 text-right font-normal\">Option today</th>\n                    {profiles.map((p, i) => (\n                      <th key={p.id} className=\"w-10 pb-2 font-normal\">\n                        <span\n                          className=\"mx-auto block h-28 w-4 rotate-180 text-left [writing-mode:vertical-rl]\"\n                          style={p.id === profile.id ? { color: \"var(--ink)\", fontWeight: 600 } : undefined}\n                        >\n                          Profile {letter(i)} · {p.name}\n                        </span>\n                      </th>\n                    ))}\n                  </tr>\n                </thead>\n                {CATEGORIES.map((cat) => {\n                  const list = rows.filter((r) => r.category === cat);\n                  if (!list.length) return null;\n                  const Icon = CATEGORY_ICON[cat];\n                  return (\n                    <tbody key={cat}>\n                      <tr>\n                        <td colSpan={3 + profiles.length} className=\"pt-5\">\n                          <p className=\"flex items-center gap-2 border-b border-ink/70 pb-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink\">\n                            <Icon aria-hidden className=\"size-3.5\" /> {cat}\n                          </p>\n                        </td>\n                      </tr>\n                      {list.map((r) => {\n                        const o = r.relatedOptions[0];\n                        const mine = included.has(r.id);\n                        return (\n                          <tr key={r.id} className={`border-b border-line align-top ${mine ? \"\" : \"text-muted\"}`}>\n                            <td className=\"py-2.5 pr-4\">\n                              <p className={mine ? \"font-medium text-ink\" : \"\"}>\n                                {r.title} <span className=\"text-[11px] font-normal text-muted\">#{r.priority}</span>\n                              </p>\n                              {mine && <p className=\"mt-0.5 text-[12px] text-ink-soft\">– {capitalise(draftTarget(r).replace(/^“[^”]+”: /, \"\"))}</p>}\n                              {mine && r.relatedOptions.length > 1 && (\n                                <p className=\"mt-0.5 text-[11px] text-muted\">\n                                  Also: {r.relatedOptions.slice(1).map((x) => `${x.code} ${x.name}`).join(\" · \")}\n                                </p>\n                              )}\n                            </td>\n                            <td className=\"py-2.5 font-mono text-[11px] text-muted\">{o ? o.code : r.id.split(\"-\")[1]}</td>\n                            <td className=\"py-2.5 text-right tabular-nums\">{o ? listPrice(o.priceEur) : <span className=\"text-line\">–</span>}</td>\n                            {profiles.map((p) => (\n                              <td key={p.id} className=\"py-2.5 text-center\">\n                                {mark(p, r.id)}\n                              </td>\n                            ))}\n                          </tr>\n                        );\n                      })}\n                    </tbody>\n                  );\n                })}\n                {wishes.size > 0 && (\n                  <tbody>\n                    <tr>\n                      <td colSpan={3 + profiles.length} className=\"pt-5\">\n                        <p className=\"flex items-center gap-2 border-b border-ink/70 pb-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink\">\n                          <Star aria-hidden className=\"size-3.5\" /> Wishlist · competitors &amp; trends\n                        </p>\n                      </td>\n                    </tr>\n                    {[...wishes.values()].map((w) => (\n                      <tr key={w.id} className=\"border-b border-line align-top\">\n                        <td className=\"py-2.5 pr-4\">\n                          <p className=\"font-medium text-ink\">{w.title}</p>\n                          <p className=\"mt-0.5 text-[12px] text-ink-soft\">\n                            – {w.kind === \"competitor\" ? `${w.competitor}: ` : \"\"}\n                            {w.detail}\n                          </p>\n                        </td>\n                        <td className=\"py-2.5 font-mono text-[11px] text-muted\">{w.id}</td>\n                        <td className=\"py-2.5 text-right text-line\">–</td>\n                        {profiles.map((p) => (\n                          <td key={p.id} className=\"py-2.5 text-center\">\n                            {mark(p, w.id, true)}\n                          </td>\n                        ))}\n                      </tr>\n                    ))}\n                  </tbody>\n                )}\n              </table>\n            </div>\n            <Legend />\n          </CatalogSection>\n\n          <div className=\"grid gap-12 lg:grid-cols-2\">\n            <CatalogSection title=\"Why this profile\">\n              <ol className=\"text-[13px]\">\n                {profile.why.map((w, i) => (\n                  <li key={w} className=\"flex gap-3 border-b border-line py-2.5\">\n                    <span className=\"w-4 shrink-0 tabular-nums text-muted\">{i + 1}</span>\n                    <span className=\"text-ink-soft\">{w}</span>\n                  </li>\n                ))}\n              </ol>\n            </CatalogSection>\n            <CatalogSection title=\"Principles\">\n              <table className=\"w-full text-[13px]\">\n                <tbody>\n                  {cfg.principles.map((p) => (\n                    <tr key={p.id} className=\"border-b border-line align-top\">\n                      <td className=\"w-10 py-2.5 font-mono text-[11px] font-semibold text-l1\">{p.id}</td>\n                      <td className=\"py-2.5 text-ink-soft\">{p.text}</td>\n                      <td className=\"py-2.5 pl-3 text-right text-[11px] text-muted\">{p.owner}</td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n              <p className=\"text-[11px] text-muted\">■ Every principle is respected by this profile.</p>\n            </CatalogSection>\n          </div>\n\n          <CatalogSection title=\"Competitors and trends\">\n            {signals.length === 0 ? (\n              <p className=\"text-[13px] text-muted\">No competitor or trend signal is linked to this profile.</p>\n            ) : (\n              <table className=\"w-full text-[13px]\">\n                <tbody>\n                  {signals.map(({ s, wish }) => {\n                    const Icon = wish ? Star : SIGNAL_ICON[s.kind];\n                    return (\n                      <tr key={s.id} className=\"border-b border-line align-top\">\n                        <td className=\"w-8 py-2.5\">\n                          <Icon aria-hidden className={`size-4 ${wish ? \"text-brand\" : \"text-l3\"}`} fill={wish ? \"currentColor\" : \"none\"} />\n                        </td>\n                        <td className=\"py-2.5 pr-4\">\n                          <p className=\"font-medium text-ink\">{s.kind === \"competitor\" ? `${s.competitor}: ${s.title}` : s.title}</p>\n                          <p className=\"text-ink-soft\">{s.detail}</p>\n                        </td>\n                        <td className=\"hidden w-36 py-2.5 text-[11px] text-muted sm:table-cell\">\n                          {wish ? \"Wishlist\" : `Backs ${s.relatesTo.length} request${s.relatesTo.length > 1 ? \"s\" : \"\"}`}\n                        </td>\n                        <td className=\"w-44 py-2.5 text-right text-[11px]\">\n                          {s.sources.slice(0, 1).map((src) => (\n                            <a key={src.url} href={src.url} target=\"_blank\" rel=\"noreferrer\" className=\"inline-flex items-center gap-0.5 text-brand hover:underline\">\n                              {src.label}\n                              <ExternalLink aria-hidden className=\"size-3\" />\n                            </a>\n                          ))}\n                        </td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            )}\n          </CatalogSection>\n\n          <CatalogSection title=\"Decision trail\">\n            {rejected.length === 0 && keptOut.length === 0 ? (\n              <p className=\"text-[13px] text-muted\">No rejections. Every request you kept is in this profile.</p>\n            ) : (\n              <table className=\"w-full text-[13px]\">\n                <tbody>\n                  {rejected.map((d) => (\n                    <tr key={d.requestId} className=\"border-b border-line align-top\">\n                      <td className=\"w-24 py-2.5 text-[11px] font-semibold uppercase tracking-wider text-bad\">Rejected</td>\n                      <td className=\"py-2.5 pr-4\">\n                        <p className=\"font-medium text-ink\">{d.title}</p>\n                        <p className=\"text-ink-soft\">“{d.reason}”</p>\n                      </td>\n                      <td className=\"w-44 py-2.5 text-right text-[11px] text-muted\">\n                        {d.by}\n                        <br />\n                        {new Date(d.at).toLocaleString(\"en-GB\", { dateStyle: \"medium\", timeStyle: \"short\" })}\n                      </td>\n                    </tr>\n                  ))}\n                  {keptOut.map((d) => (\n                    <tr key={d.requestId} className=\"border-b border-line align-top\">\n                      <td className=\"w-24 py-2.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Kept</td>\n                      <td className=\"py-2.5 text-ink-soft\" colSpan={2}>\n                        {d.title} <span className=\"text-muted\">· in another profile</span>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            )}\n          </CatalogSection>\n\n          <footer className=\"border-t border-line pt-4 text-[11px] leading-relaxed text-muted\">\n            <Legend />\n            <p className=\"mt-2\">\n              Evidence: BMW customer feedback, customer studies, sales and the German option list (July 2026, EUR incl. 19% VAT). Competitor and trend signals link their\n              public sources. Principles and competitor notes are example content; the social test is simulated. {image && `${image.credit}, modified.`}\n            </p>\n          </footer>\n        </div>\n      </article>\n    </div>\n  );\n}\n\n/* ---------- catalogue building blocks ---------- */\n\nfunction CatalogSection({ title, note, children }: { title: string; note?: string; children: React.ReactNode }) {\n  return (\n    <section className=\"flex flex-col gap-4\">\n      <div>\n        <h2 className=\"text-xl font-semibold uppercase tracking-tight text-ink sm:text-2xl\">{title}.</h2>\n        {note && <p className=\"mt-1 text-[12px] text-muted\">{note}</p>}\n      </div>\n      {children}\n    </section>\n  );\n}\n\nfunction Band({ cols, children }: { cols: number; children: React.ReactNode }) {\n  return (\n    <thead>\n      <tr>\n        <th colSpan={cols} className=\"bg-bg-soft px-3 py-2 text-left text-xs font-semibold uppercase tracking-[0.12em] text-ink\">\n          {children}\n        </th>\n      </tr>\n    </thead>\n  );\n}\n\nfunction Row({ label, value, strong }: { label: string; value: React.ReactNode; strong?: boolean }) {\n  return (\n    <tr className=\"border-b border-line\">\n      <td className={`px-3 py-2 ${strong ? \"font-semibold uppercase tracking-wide text-ink\" : \"text-ink-soft\"}`}>{label}</td>\n      <td className={`px-3 py-2 text-right tabular-nums ${strong ? \"font-semibold text-ink\" : \"text-ink\"}`}>{value}</td>\n    </tr>\n  );\n}\n\nfunction Legend() {\n  return (\n    <p className=\"flex flex-wrap gap-x-6 gap-y-1 text-[11px] text-muted\">\n      <span>■ In this profile</span>\n      <span>□ In another profile</span>\n      <span>– Not included</span>\n      <span>–,– Included or no price on today&apos;s option list</span>\n    </p>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":240,"cache_read_input_tokens":443232,"output_tokens":9744,"output_tokens_details":{"thinking_tokens":18},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":240,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":9744,"cache_read_input_tokens":443232,"cache_creation_input_tokens":240,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":240},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01C5sXghMezxCtyHVeimiaEE":{"file_path":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/pipeline/Profiles.tsx","content":"\"use client\";\n\nimport Image from \"next/image\";\nimport { ArrowLeft, ArrowRight, Download, ExternalLink, Star, Trophy } from \"lucide-react\";\nimport type { CarImage } from \"@/lib/car-images\";\nimport { draftTarget, type Decisions, type Profile } from \"@/lib/pipeline/profiles\";\nimport type { SeriesConfig } from \"@/lib/pipeline/series\";\nimport type { Session } from \"@/lib/pipeline/sessions\";\nimport { CATEGORIES, type FeatureRequest, type MarketSignal } from \"@/lib/pipeline/types\";\nimport { PROFILE_COLOR } from \"./Analytics\";\nimport { CATEGORY_ICON, SIGNAL_ICON } from \"./icons\";\n\nconst layerParts = (score: Profile[\"score\"], l3Weight: number) => {\n  const w3 = score.l3 === null ? 0 : l3Weight;\n  const w1 = 0.45 * (1 - w3);\n  const w2 = 1 - w1 - w3;\n  return [\n    { id: \"L1\", cls: \"bg-l1\", v: w1 * score.l1, label: \"principles\" },\n    { id: \"L2\", cls: \"bg-l2\", v: w2 * score.l2, label: \"evidence\" },\n    { id: \"L3\", cls: \"bg-l3\", v: w3 * (score.l3 ?? 0), label: \"social test\" },\n  ];\n};\n\n/** Stacked bar: how much each layer contributes to a profile's score. */\nexport function LayerScore({ score, l3Weight, dark }: { score: Profile[\"score\"]; l3Weight: number; dark?: boolean }) {\n  const parts = layerParts(score, l3Weight);\n  const pct = Math.round(score.total * 100);\n  return (\n    <div className=\"flex items-center gap-3\">\n      <div\n        role=\"img\"\n        aria-label={`Score ${pct} of 100: ${parts.map((p) => `${p.label} ${Math.round(p.v * 100)}`).join(\", \")}`}\n        className={`flex h-2 flex-1 overflow-hidden rounded-full ${dark ? \"bg-white/10\" : \"bg-bg-soft ring-1 ring-inset ring-line\"}`}\n      >\n        {parts.map((p) => (\n          <span key={p.id} className={`h-full ${dark && p.id === \"L1\" ? \"bg-brand-sky\" : p.cls}`} style={{ width: `${p.v * 100}%` }} />\n        ))}\n      </div>\n      <span aria-hidden className={`w-7 text-right text-sm font-semibold tabular-nums ${dark ? \"text-white\" : \"text-ink\"}`}>\n        {pct}\n      </span>\n    </div>\n  );\n}\n\nconst letter = (i: number) => String.fromCharCode(65 + i);\nconst capitalise = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);\n/** Price in the option-list style: 1.900,– */\nconst listPrice = (n: number | null) => (n === null ? \"–,–\" : `${n.toLocaleString(\"de-DE\")},–`);\n\n/* ---------- dashboard cards ---------- */\n\nexport function ProfileList({ profiles, cfg, image, onOpen }: { profiles: Profile[]; cfg: SeriesConfig; image?: CarImage; onOpen: (id: string) => void }) {\n  return (\n    <ul className=\"grid gap-5 lg:grid-cols-3\">\n      {profiles.map((p, i) => {\n        const color = PROFILE_COLOR[p.id];\n        return (\n          <li key={p.id}>\n            <button\n              type=\"button\"\n              onClick={() => onOpen(p.id)}\n              className=\"group flex h-full w-full flex-col overflow-hidden rounded-[22px] bg-ink text-left text-white shadow-card ring-1 ring-line transition-[box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-float motion-reduce:transition-none motion-reduce:hover:translate-y-0\"\n            >\n              <div className=\"relative aspect-[16/9] overflow-hidden\">\n                {image && (\n                  <Image\n                    src={image.src}\n                    alt=\"\"\n                    fill\n                    sizes=\"(min-width: 1024px) 30vw, 100vw\"\n                    className=\"object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none\"\n                  />\n                )}\n                {/* tint the photo in the profile's colour, then fade into the card */}\n                <div aria-hidden className=\"absolute inset-0 opacity-35 mix-blend-color\" style={{ backgroundColor: color.stroke }} />\n                <div aria-hidden className=\"absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink to-transparent\" />\n                <span className=\"absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-2.5 py-1 text-xs font-semibold tracking-wider ring-1 ring-white/20 backdrop-blur-md\">\n                  <span aria-hidden className=\"size-2 rounded-full\" style={{ backgroundColor: color.stroke }} />\n                  PROFILE {letter(i)}\n                </span>\n                {i === 0 && (\n                  <span className=\"absolute right-4 top-4 inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-ink\">\n                    <Trophy aria-hidden className=\"size-3.5 text-brand\" /> Best fit\n                  </span>\n                )}\n              </div>\n\n              <div className=\"-mt-4 flex flex-1 flex-col gap-4 p-5 pt-0\">\n                <div className=\"relative\">\n                  <h3 className=\"text-2xl font-semibold tracking-tight\">{p.name}</h3>\n                  <p className=\"text-sm text-white/65\">{p.tagline}</p>\n                </div>\n                <LayerScore score={p.score} l3Weight={cfg.l3Weight} dark />\n                <ul className=\"flex flex-col gap-2 text-sm\">\n                  {p.requests.slice(0, 4).map((r) => {\n                    const Icon = CATEGORY_ICON[r.category];\n                    return (\n                      <li key={r.id} className=\"flex items-center gap-2.5\">\n                        <span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-white/10\">\n                          <Icon aria-hidden className=\"size-3.5 text-brand-sky\" />\n                        </span>\n                        <span className=\"min-w-0 flex-1 truncate text-white/85\">{r.title}</span>\n                        <span className=\"shrink-0 text-xs tabular-nums text-white/45\">#{r.priority}</span>\n                      </li>\n                    );\n                  })}\n                  {p.wishes.map((w) => (\n                    <li key={w.id} className=\"flex items-center gap-2.5\">\n                      <span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-white/10\">\n                        <Star aria-hidden className=\"size-3.5 text-brand-sky\" fill=\"currentColor\" />\n                      </span>\n                      <span className=\"min-w-0 flex-1 truncate text-white/85\">{w.title}</span>\n                    </li>\n                  ))}\n                </ul>\n                <span className=\"mt-auto inline-flex h-10 items-center justify-between rounded-full bg-white px-4 text-sm font-medium text-ink transition-colors group-hover:bg-brand group-hover:text-white\">\n                  Open profile\n                  <ArrowRight aria-hidden className=\"size-4 transition-transform group-hover:translate-x-0.5\" />\n                </span>\n              </div>\n            </button>\n          </li>\n        );\n      })}\n    </ul>\n  );\n}\n\n/* ---------- profile page: laid out like BMW's option-list catalogue ---------- */\n\nexport function ProfileDetail({\n  profile,\n  profiles,\n  rank,\n  cfg,\n  scopeLabel,\n  decisions,\n  session,\n  image,\n  onBack,\n}: {\n  profile: Profile;\n  /** All profiles of the session, for the comparison columns. */\n  profiles: Profile[];\n  rank: number;\n  cfg: SeriesConfig;\n  scopeLabel: string;\n  decisions: Decisions;\n  session: Session;\n  image?: CarImage;\n  onBack: () => void;\n}) {\n  const color = PROFILE_COLOR[profile.id];\n  const included = new Set(profile.requests.map((r) => r.id));\n  const all = Object.values(decisions);\n  const rejected = all.filter((d) => d.action === \"reject\");\n  const keptOut = all.filter((d) => d.action === \"keep\" && !included.has(d.requestId));\n\n  /* Every requirement of the session, so the matrix compares this profile with the others. */\n  const union = new Map<string, FeatureRequest & { scoped: number; priority: number }>();\n  profiles.forEach((p) => p.requests.forEach((r) => union.set(r.id, r)));\n  const rows = [...union.values()].sort((a, b) => a.priority - b.priority);\n  const wishes = new Map<string, MarketSignal>();\n  profiles.forEach((p) => p.wishes.forEach((w) => wishes.set(w.id, w)));\n\n  const options = profile.requests.flatMap((r) => r.relatedOptions);\n  const optionTotal = options.reduce((s, o) => s + (o.priceEur ?? 0), 0);\n  const covered = profile.requests.reduce((s, r) => s + r.scoped, 0);\n  const signals = [...profile.wishes.map((s) => ({ s, wish: true })), ...profile.backing.filter((b) => !profile.wishes.includes(b)).map((s) => ({ s, wish: false }))];\n  const date = new Date(session.createdAt).toLocaleDateString(\"en-GB\", { month: \"long\", year: \"numeric\" }).toUpperCase();\n  const seriesNo = cfg.name.split(\" \")[0];\n\n  const mark = (p: Profile, id: string, isWish = false) => {\n    const has = isWish ? p.wishes.some((w) => w.id === id) : p.requests.some((r) => r.id === id);\n    if (!has) return <span className=\"text-line\">–</span>;\n    return p.id === profile.id ? <span title=\"In this profile\">■</span> : <span title=\"In another profile\" className=\"text-muted\">□</span>;\n  };\n\n  return (\n    <div className=\"flex flex-col gap-5\">\n      <div data-no-print className=\"flex items-center justify-between gap-3\">\n        <button type=\"button\" onClick={onBack} className=\"inline-flex items-center gap-1.5 text-sm text-muted hover:text-brand\">\n          <ArrowLeft aria-hidden className=\"size-4\" /> All profiles\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => window.print()}\n          title=\"Opens the print dialog: choose “Save as PDF”\"\n          className=\"inline-flex h-10 items-center gap-2 rounded-full bg-ink px-4 text-sm font-medium text-white shadow-card transition-colors hover:bg-brand-deep\"\n        >\n          <Download aria-hidden className=\"size-4\" /> Download PDF\n        </button>\n      </div>\n\n      <article data-print-root className=\"flex flex-col gap-12 rounded-[22px] border border-line bg-surface pb-10 shadow-card print:border-0\">\n        {/* Cover */}\n        <header className=\"relative isolate min-h-[440px] overflow-hidden rounded-t-[22px] bg-ink text-white\">\n          {image && <Image src={image.src} alt={image.alt} fill loading=\"eager\" sizes=\"(min-width: 1024px) 70vw, 100vw\" className=\"-z-10 object-cover\" />}\n          <div aria-hidden className=\"absolute inset-0 -z-10 bg-gradient-to-r from-ink/85 via-ink/30 to-transparent\" />\n          <div aria-hidden className=\"absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-ink/80 to-transparent\" />\n          <div className=\"flex min-h-[440px] flex-col justify-between p-8 sm:p-10\">\n            <div>\n              <p className=\"text-6xl font-light tracking-tight sm:text-7xl\">BMW {seriesNo}</p>\n              <p className=\"mt-2 text-sm font-semibold uppercase tracking-[0.3em] text-white/80\">\n                Profile {letter(rank)} · {profile.name}\n              </p>\n              <p className=\"mt-4 max-w-sm text-white/75\">{profile.tagline}</p>\n            </div>\n            <div className=\"flex flex-wrap items-end justify-between gap-4 text-xs\">\n              <div className=\"flex flex-col gap-1\">\n                <span className=\"inline-flex items-center gap-2 font-semibold uppercase tracking-[0.2em]\">\n                  <span aria-hidden className=\"size-2.5 rounded-full\" style={{ backgroundColor: color.stroke }} />\n                  {scopeLabel} · {date}\n                </span>\n                <span className=\"text-white/55\">Dixi requirement profile · Session {session.id}</span>\n              </div>\n              {image && (\n                <a href={image.page} target=\"_blank\" rel=\"noreferrer\" className=\"text-white/50 hover:text-white hover:underline\">\n                  {image.credit} · modified\n                </a>\n              )}\n            </div>\n          </div>\n        </header>\n\n        <div className=\"flex flex-col gap-12 px-6 sm:px-10\">\n          {/* At a glance: like \"Fahrzeugpreise\" */}\n          <CatalogSection title=\"Profile at a glance\">\n            <div className=\"grid gap-8 md:grid-cols-2\">\n              <table className=\"w-full text-[13px]\">\n                <Band cols={2}>Score</Band>\n                <tbody>\n                  <Row label=\"L1 · Principles and your priority\" value={Math.round(profile.score.l1 * 100)} />\n                  <Row label=\"L2 · Evidence covered\" value={Math.round(profile.score.l2 * 100)} />\n                  <Row label={`L3 · Social test (max ${Math.round(cfg.l3Weight * 100)}%)`} value={profile.score.l3 === null ? \"not run\" : Math.round(profile.score.l3 * 100)} />\n                  <Row label=\"Total score\" value={Math.round(profile.score.total * 100)} strong />\n                </tbody>\n              </table>\n              <table className=\"w-full text-[13px]\">\n                <Band cols={2}>Scope</Band>\n                <tbody>\n                  <Row label=\"Series · market\" value={`${cfg.name} (${cfg.id}) · ${scopeLabel}`} />\n                  <Row label=\"Requirements\" value={profile.requests.length} />\n                  <Row label=\"Customer mentions covered\" value={covered.toLocaleString(\"en\")} />\n                  <Row label=\"From the wishlist\" value={profile.wishes.length} />\n                  <Row label=\"Related options today (EUR incl. VAT)\" value={listPrice(optionTotal || null)} strong />\n                </tbody>\n              </table>\n            </div>\n          </CatalogSection>\n\n          {/* Requirements matrix: like \"Sonderausstattungen\" */}\n          <CatalogSection title=\"Requirements\" note=\"In your priority order. Columns compare the three profiles of this session.\">\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full min-w-[640px] text-[13px]\">\n                <thead>\n                  <tr className=\"align-bottom text-[11px] text-muted\">\n                    <th className=\"pb-2 text-left font-normal\" />\n                    <th className=\"w-16 pb-2 text-left font-normal\">Code</th>\n                    <th className=\"w-28 pb-2 text-right font-normal\">Option today</th>\n                    {profiles.map((p, i) => (\n                      <th key={p.id} className=\"w-10 pb-2 font-normal\">\n                        <span\n                          className=\"mx-auto block h-28 w-4 rotate-180 text-left [writing-mode:vertical-rl]\"\n                          style={p.id === profile.id ? { color: \"var(--ink)\", fontWeight: 600 } : undefined}\n                        >\n                          Profile {letter(i)} · {p.name}\n                        </span>\n                      </th>\n                    ))}\n                  </tr>\n                </thead>\n                {CATEGORIES.map((cat) => {\n                  const list = rows.filter((r) => r.category === cat);\n                  if (!list.length) return null;\n                  const Icon = CATEGORY_ICON[cat];\n                  return (\n                    <tbody key={cat}>\n                      <tr>\n                        <td colSpan={3 + profiles.length} className=\"pt-5\">\n                          <p className=\"flex items-center gap-2 border-b border-ink/70 pb-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink\">\n                            <Icon aria-hidden className=\"size-3.5\" /> {cat}\n                          </p>\n                        </td>\n                      </tr>\n                      {list.map((r) => {\n                        const o = r.relatedOptions[0];\n                        const mine = included.has(r.id);\n                        return (\n                          <tr key={r.id} className={`border-b border-line align-top ${mine ? \"\" : \"text-muted\"}`}>\n                            <td className=\"py-2.5 pr-4\">\n                              <p className={mine ? \"font-medium text-ink\" : \"\"}>\n                                {r.title} <span className=\"text-[11px] font-normal text-muted\">#{r.priority}</span>\n                              </p>\n                              {mine && <p className=\"mt-0.5 text-[12px] text-ink-soft\">– {capitalise(draftTarget(r).replace(/^“[^”]+”: /, \"\"))}</p>}\n                              {mine && r.relatedOptions.length > 1 && (\n                                <p className=\"mt-0.5 text-[11px] text-muted\">\n                                  Also: {r.relatedOptions.slice(1).map((x) => `${x.code} ${x.name}`).join(\" · \")}\n                                </p>\n                              )}\n                            </td>\n                            <td className=\"py-2.5 font-mono text-[11px] text-muted\">{o ? o.code : r.id.split(\"-\")[1]}</td>\n                            <td className=\"py-2.5 text-right tabular-nums\">{o ? listPrice(o.priceEur) : <span className=\"text-line\">–</span>}</td>\n                            {profiles.map((p) => (\n                              <td key={p.id} className=\"py-2.5 text-center\">\n                                {mark(p, r.id)}\n                              </td>\n                            ))}\n                          </tr>\n                        );\n                      })}\n                    </tbody>\n                  );\n                })}\n                {wishes.size > 0 && (\n                  <tbody>\n                    <tr>\n                      <td colSpan={3 + profiles.length} className=\"pt-5\">\n                        <p className=\"flex items-center gap-2 border-b border-ink/70 pb-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink\">\n                          <Star aria-hidden className=\"size-3.5\" /> Wishlist · competitors &amp; trends\n                        </p>\n                      </td>\n                    </tr>\n                    {[...wishes.values()].map((w) => (\n                      <tr key={w.id} className=\"border-b border-line align-top\">\n                        <td className=\"py-2.5 pr-4\">\n                          <p className=\"font-medium text-ink\">{w.title}</p>\n                          <p className=\"mt-0.5 text-[12px] text-ink-soft\">\n                            – {w.kind === \"competitor\" ? `${w.competitor}: ` : \"\"}\n                            {w.detail}\n                          </p>\n                        </td>\n                        <td className=\"py-2.5 font-mono text-[11px] text-muted\">{w.id}</td>\n                        <td className=\"py-2.5 text-right text-line\">–</td>\n                        {profiles.map((p) => (\n                          <td key={p.id} className=\"py-2.5 text-center\">\n                            {mark(p, w.id, true)}\n                          </td>\n                        ))}\n                      </tr>\n                    ))}\n                  </tbody>\n                )}\n              </table>\n            </div>\n            <Legend />\n          </CatalogSection>\n\n          <div className=\"grid gap-12 lg:grid-cols-2\">\n            <CatalogSection title=\"Why this profile\">\n              <ol className=\"text-[13px]\">\n                {profile.why.map((w, i) => (\n                  <li key={w} className=\"flex gap-3 border-b border-line py-2.5\">\n                    <span className=\"w-4 shrink-0 tabular-nums text-muted\">{i + 1}</span>\n                    <span className=\"text-ink-soft\">{w}</span>\n                  </li>\n                ))}\n              </ol>\n            </CatalogSection>\n            <CatalogSection title=\"Principles\">\n              <table className=\"w-full text-[13px]\">\n                <tbody>\n                  {cfg.principles.map((p) => (\n                    <tr key={p.id} className=\"border-b border-line align-top\">\n                      <td className=\"w-10 py-2.5 font-mono text-[11px] font-semibold text-l1\">{p.id}</td>\n                      <td className=\"py-2.5 text-ink-soft\">{p.text}</td>\n                      <td className=\"py-2.5 pl-3 text-right text-[11px] text-muted\">{p.owner}</td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n              <p className=\"text-[11px] text-muted\">■ Every principle is respected by this profile.</p>\n            </CatalogSection>\n          </div>\n\n          <CatalogSection title=\"Competitors and trends\">\n            {signals.length === 0 ? (\n              <p className=\"text-[13px] text-muted\">No competitor or trend signal is linked to this profile.</p>\n            ) : (\n              <table className=\"w-full text-[13px]\">\n                <tbody>\n                  {signals.map(({ s, wish }) => {\n                    const Icon = wish ? Star : SIGNAL_ICON[s.kind];\n                    return (\n                      <tr key={s.id} className=\"border-b border-line align-top\">\n                        <td className=\"w-8 py-2.5\">\n                          <Icon aria-hidden className={`size-4 ${wish ? \"text-brand\" : \"text-l3\"}`} fill={wish ? \"currentColor\" : \"none\"} />\n                        </td>\n                        <td className=\"py-2.5 pr-4\">\n                          <p className=\"font-medium text-ink\">{s.kind === \"competitor\" ? `${s.competitor}: ${s.title}` : s.title}</p>\n                          <p className=\"text-ink-soft\">{s.detail}</p>\n                        </td>\n                        <td className=\"hidden w-36 py-2.5 text-[11px] text-muted sm:table-cell\">\n                          {wish ? \"Wishlist\" : `Backs ${s.relatesTo.length} request${s.relatesTo.length > 1 ? \"s\" : \"\"}`}\n                        </td>\n                        <td className=\"w-44 py-2.5 text-right text-[11px]\">\n                          {s.sources.slice(0, 1).map((src) => (\n                            <a key={src.url} href={src.url} target=\"_blank\" rel=\"noreferrer\" className=\"inline-flex items-center gap-0.5 text-brand hover:underline\">\n                              {src.label}\n                              <ExternalLink aria-hidden className=\"size-3\" />\n                            </a>\n                          ))}\n                        </td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            )}\n          </CatalogSection>\n\n          <CatalogSection title=\"Decision trail\">\n            {rejected.length === 0 && keptOut.length === 0 ? (\n              <p className=\"text-[13px] text-muted\">No rejections. Every request you kept is in this profile.</p>\n            ) : (\n              <table className=\"w-full text-[13px]\">\n                <tbody>\n                  {rejected.map((d) => (\n                    <tr key={d.requestId} className=\"border-b border-line align-top\">\n                      <td className=\"w-24 py-2.5 text-[11px] font-semibold uppercase tracking-wider text-bad\">Rejected</td>\n                      <td className=\"py-2.5 pr-4\">\n                        <p className=\"font-medium text-ink\">{d.title}</p>\n                        <p className=\"text-ink-soft\">“{d.reason}”</p>\n                      </td>\n                      <td className=\"w-44 py-2.5 text-right text-[11px] text-muted\">\n                        {d.by}\n                        <br />\n                        {new Date(d.at).toLocaleString(\"en-GB\", { dateStyle: \"medium\", timeStyle: \"short\" })}\n                      </td>\n                    </tr>\n                  ))}\n                  {keptOut.map((d) => (\n                    <tr key={d.requestId} className=\"border-b border-line align-top\">\n                      <td className=\"w-24 py-2.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Kept</td>\n                      <td className=\"py-2.5 text-ink-soft\" colSpan={2}>\n                        {d.title} <span className=\"text-muted\">· in another profile</span>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            )}\n          </CatalogSection>\n\n          <footer className=\"border-t border-line pt-4 text-[11px] leading-relaxed text-muted\">\n            <Legend />\n            <p className=\"mt-2\">\n              Evidence: BMW customer feedback, customer studies, sales and the German option list (July 2026, EUR incl. 19% VAT). Competitor and trend signals link their\n              public sources. Principles and competitor notes are example content; the social test is simulated. {image && `${image.credit}, modified.`}\n            </p>\n          </footer>\n        </div>\n      </article>\n    </div>\n  );\n}\n\n/* ---------- catalogue building blocks ---------- */\n\nfunction CatalogSection({ title, note, children }: { title: string; note?: string; children: React.ReactNode }) {\n  return (\n    <section className=\"flex flex-col gap-4\">\n      <div>\n        <h2 className=\"text-xl font-semibold uppercase tracking-tight text-ink sm:text-2xl\">{title}.</h2>\n        {note && <p className=\"mt-1 text-[12px] text-muted\">{note}</p>}\n      </div>\n      {children}\n    </section>\n  );\n}\n\nfunction Band({ cols, children }: { cols: number; children: React.ReactNode }) {\n  return (\n    <thead>\n      <tr>\n        <th colSpan={cols} className=\"bg-bg-soft px-3 py-2 text-left text-xs font-semibold uppercase tracking-[0.12em] text-ink\">\n          {children}\n        </th>\n      </tr>\n    </thead>\n  );\n}\n\nfunction Row({ label, value, strong }: { label: string; value: React.ReactNode; strong?: boolean }) {\n  return (\n    <tr className=\"border-b border-line\">\n      <td className={`px-3 py-2 ${strong ? \"font-semibold uppercase tracking-wide text-ink\" : \"text-ink-soft\"}`}>{label}</td>\n      <td className={`px-3 py-2 text-right tabular-nums ${strong ? \"font-semibold text-ink\" : \"text-ink\"}`}>{value}</td>\n    </tr>\n  );\n}\n\nfunction Legend() {\n  return (\n    <p className=\"flex flex-wrap gap-x-6 gap-y-1 text-[11px] text-muted\">\n      <span>■ In this profile</span>\n      <span>□ In another profile</span>\n      <span>– Not included</span>\n      <span>–,– Included or no price on today&apos;s option list</span>\n    </p>\n  );\n}\n"}},"apiBlockIndex":1,"requestId":"req_011CfuAPdwVb15cPNqkt5i6s","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"a778837a-c5f7-4663-9b2c-2196fc573142","timestamp":"2026-10-10T20:10:28.659Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"53e0d48f-0e86-4176-8390-70cad3fe3f46","userType":"external","entrypoint":"cli","cwd":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web","sessionId":"7fd52f13-5d0c-4e7f-8ec6-8a947b2499a1","version":"2.1.296","gitBranch":"main","slug":"federated-petting-ripple"}
{"parentUuid":"a778837a-c5f7-4663-9b2c-2196fc573142","isSidechain":false,"promptId":"8bcd57e0-bfef-4f3c-b7bd-f8571343c1e5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C5sXghMezxCtyHVeimiaEE","type":"tool_result","content":"The file /Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/pipeline/Profiles.tsx has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"65643ae9-35f1-453d-90b9-d1bf60509bad","timestamp":"2026-10-10T20:10:28.730Z","toolUseResult":{"type":"update","filePath":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/pipeline/Profiles.tsx","content":"\"use client\";\n\nimport Image from \"next/image\";\nimport { ArrowLeft, ArrowRight, Download, ExternalLink, Star, Trophy } from \"lucide-react\";\nimport type { CarImage } from \"@/lib/car-images\";\nimport { draftTarget, type Decisions, type Profile } from \"@/lib/pipeline/profiles\";\nimport type { SeriesConfig } from \"@/lib/pipeline/series\";\nimport type { Session } from \"@/lib/pipeline/sessions\";\nimport { CATEGORIES, type FeatureRequest, type MarketSignal } from \"@/lib/pipeline/types\";\nimport { PROFILE_COLOR } from \"./Analytics\";\nimport { CATEGORY_ICON, SIGNAL_ICON } from \"./icons\";\n\nconst layerParts = (score: Profile[\"score\"], l3Weight: number) => {\n  const w3 = score.l3 === null ? 0 : l3Weight;\n  const w1 = 0.45 * (1 - w3);\n  const w2 = 1 - w1 - w3;\n  return [\n    { id: \"L1\", cls: \"bg-l1\", v: w1 * score.l1, label: \"principles\" },\n    { id: \"L2\", cls: \"bg-l2\", v: w2 * score.l2, label: \"evidence\" },\n    { id: \"L3\", cls: \"bg-l3\", v: w3 * (score.l3 ?? 0), label: \"social test\" },\n  ];\n};\n\n/** Stacked bar: how much each layer contributes to a profile's score. */\nexport function LayerScore({ score, l3Weight, dark }: { score: Profile[\"score\"]; l3Weight: number; dark?: boolean }) {\n  const parts = layerParts(score, l3Weight);\n  const pct = Math.round(score.total * 100);\n  return (\n    <div className=\"flex items-center gap-3\">\n      <div\n        role=\"img\"\n        aria-label={`Score ${pct} of 100: ${parts.map((p) => `${p.label} ${Math.round(p.v * 100)}`).join(\", \")}`}\n        className={`flex h-2 flex-1 overflow-hidden rounded-full ${dark ? \"bg-white/10\" : \"bg-bg-soft ring-1 ring-inset ring-line\"}`}\n      >\n        {parts.map((p) => (\n          <span key={p.id} className={`h-full ${dark && p.id === \"L1\" ? \"bg-brand-sky\" : p.cls}`} style={{ width: `${p.v * 100}%` }} />\n        ))}\n      </div>\n      <span aria-hidden className={`w-7 text-right text-sm font-semibold tabular-nums ${dark ? \"text-white\" : \"text-ink\"}`}>\n        {pct}\n      </span>\n    </div>\n  );\n}\n\nconst letter = (i: number) => String.fromCharCode(65 + i);\nconst capitalise = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);\n/** Price in the option-list style: 1.900,– */\nconst listPrice = (n: number | null) => (n === null ? \"–,–\" : `${n.toLocaleString(\"de-DE\")},–`);\n\n/* ---------- dashboard cards ---------- */\n\nexport function ProfileList({ profiles, cfg, image, onOpen }: { profiles: Profile[]; cfg: SeriesConfig; image?: CarImage; onOpen: (id: string) => void }) {\n  return (\n    <ul className=\"grid gap-5 lg:grid-cols-3\">\n      {profiles.map((p, i) => {\n        const color = PROFILE_COLOR[p.id];\n        return (\n          <li key={p.id}>\n            <button\n              type=\"button\"\n              onClick={() => onOpen(p.id)}\n              className=\"group flex h-full w-full flex-col overflow-hidden rounded-[22px] bg-ink text-left text-white shadow-card ring-1 ring-line transition-[box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-float motion-reduce:transition-none motion-reduce:hover:translate-y-0\"\n            >\n              <div className=\"relative aspect-[16/9] overflow-hidden\">\n                {image && (\n                  <Image\n                    src={image.src}\n                    alt=\"\"\n                    fill\n                    sizes=\"(min-width: 1024px) 30vw, 100vw\"\n                    className=\"object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none\"\n                  />\n                )}\n                {/* tint the photo in the profile's colour, then fade into the card */}\n                <div aria-hidden className=\"absolute inset-0 opacity-35 mix-blend-color\" style={{ backgroundColor: color.stroke }} />\n                <div aria-hidden className=\"absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink to-transparent\" />\n                <span className=\"absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-2.5 py-1 text-xs font-semibold tracking-wider ring-1 ring-white/20 backdrop-blur-md\">\n                  <span aria-hidden className=\"size-2 rounded-full\" style={{ backgroundColor: color.stroke }} />\n                  PROFILE {letter(i)}\n                </span>\n                {i === 0 && (\n                  <span className=\"absolute right-4 top-4 inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-ink\">\n                    <Trophy aria-hidden className=\"size-3.5 text-brand\" /> Best fit\n                  </span>\n                )}\n              </div>\n\n              <div className=\"-mt-4 flex flex-1 flex-col gap-4 p-5 pt-0\">\n                <div className=\"relative\">\n                  <h3 className=\"text-2xl font-semibold tracking-tight\">{p.name}</h3>\n                  <p className=\"text-sm text-white/65\">{p.tagline}</p>\n                </div>\n                <LayerScore score={p.score} l3Weight={cfg.l3Weight} dark />\n                <ul className=\"flex flex-col gap-2 text-sm\">\n                  {p.requests.slice(0, 4).map((r) => {\n                    const Icon = CATEGORY_ICON[r.category];\n                    return (\n                      <li key={r.id} className=\"flex items-center gap-2.5\">\n                        <span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-white/10\">\n                          <Icon aria-hidden className=\"size-3.5 text-brand-sky\" />\n                        </span>\n                        <span className=\"min-w-0 flex-1 truncate text-white/85\">{r.title}</span>\n                        <span className=\"shrink-0 text-xs tabular-nums text-white/45\">#{r.priority}</span>\n                      </li>\n                    );\n                  })}\n                  {p.wishes.map((w) => (\n                    <li key={w.id} className=\"flex items-center gap-2.5\">\n                      <span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-white/10\">\n                        <Star aria-hidden className=\"size-3.5 text-brand-sky\" fill=\"currentColor\" />\n                      </span>\n                      <span className=\"min-w-0 flex-1 truncate text-white/85\">{w.title}</span>\n                    </li>\n                  ))}\n                </ul>\n                <span className=\"mt-auto inline-flex h-10 items-center justify-between rounded-full bg-white px-4 text-sm font-medium text-ink transition-colors group-hover:bg-brand group-hover:text-white\">\n                  Open profile\n                  <ArrowRight aria-hidden className=\"size-4 transition-transform group-hover:translate-x-0.5\" />\n                </span>\n              </div>\n            </button>\n          </li>\n        );\n      })}\n    </ul>\n  );\n}\n\n/* ---------- profile page: laid out like BMW's option-list catalogue ---------- */\n\nexport function ProfileDetail({\n  profile,\n  profiles,\n  rank,\n  cfg,\n  scopeLabel,\n  decisions,\n  session,\n  image,\n  onBack,\n}: {\n  profile: Profile;\n  /** All profiles of the session, for the comparison columns. */\n  profiles: Profile[];\n  rank: number;\n  cfg: SeriesConfig;\n  scopeLabel: string;\n  decisions: Decisions;\n  session: Session;\n  image?: CarImage;\n  onBack: () => void;\n}) {\n  const color = PROFILE_COLOR[profile.id];\n  const included = new Set(profile.requests.map((r) => r.id));\n  const all = Object.values(decisions);\n  const rejected = all.filter((d) => d.action === \"reject\");\n  const keptOut = all.filter((d) => d.action === \"keep\" && !included.has(d.requestId));\n\n  /* Every requirement of the session, so the matrix compares this profile with the others. */\n  const union = new Map<string, FeatureRequest & { scoped: number; priority: number }>();\n  profiles.forEach((p) => p.requests.forEach((r) => union.set(r.id, r)));\n  const rows = [...union.values()].sort((a, b) => a.priority - b.priority);\n  const wishes = new Map<string, MarketSignal>();\n  profiles.forEach((p) => p.wishes.forEach((w) => wishes.set(w.id, w)));\n\n  const options = profile.requests.flatMap((r) => r.relatedOptions);\n  const optionTotal = options.reduce((s, o) => s + (o.priceEur ?? 0), 0);\n  const covered = profile.requests.reduce((s, r) => s + r.scoped, 0);\n  const signals = [...profile.wishes.map((s) => ({ s, wish: true })), ...profile.backing.filter((b) => !profile.wishes.includes(b)).map((s) => ({ s, wish: false }))];\n  const date = new Date(session.createdAt).toLocaleDateString(\"en-GB\", { month: \"long\", year: \"numeric\" }).toUpperCase();\n  const seriesNo = cfg.name.split(\" \")[0];\n\n  const mark = (p: Profile, id: string, isWish = false) => {\n    const has = isWish ? p.wishes.some((w) => w.id === id) : p.requests.some((r) => r.id === id);\n    if (!has) return <span className=\"text-line\">–</span>;\n    return p.id === profile.id ? <span title=\"In this profile\">■</span> : <span title=\"In another profile\" className=\"text-muted\">□</span>;\n  };\n\n  return (\n    <div className=\"flex flex-col gap-5\">\n      <div data-no-print className=\"flex items-center justify-between gap-3\">\n        <button type=\"button\" onClick={onBack} className=\"inline-flex items-center gap-1.5 text-sm text-muted hover:text-brand\">\n          <ArrowLeft aria-hidden className=\"size-4\" /> All profiles\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => window.print()}\n          title=\"Opens the print dialog: choose “Save as PDF”\"\n          className=\"inline-flex h-10 items-center gap-2 rounded-full bg-ink px-4 text-sm font-medium text-white shadow-card transition-colors hover:bg-brand-deep\"\n        >\n          <Download aria-hidden className=\"size-4\" /> Download PDF\n        </button>\n      </div>\n\n      <article data-print-root className=\"flex flex-col gap-12 rounded-[22px] border border-line bg-surface pb-10 shadow-card print:border-0\">\n        {/* Cover */}\n        <header className=\"relative isolate min-h-[440px] overflow-hidden rounded-t-[22px] bg-ink text-white\">\n          {image && <Image src={image.src} alt={image.alt} fill loading=\"eager\" sizes=\"(min-width: 1024px) 70vw, 100vw\" className=\"-z-10 object-cover\" />}\n          <div aria-hidden className=\"absolute inset-0 -z-10 bg-gradient-to-r from-ink/85 via-ink/30 to-transparent\" />\n          <div aria-hidden className=\"absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-ink/80 to-transparent\" />\n          <div className=\"flex min-h-[440px] flex-col justify-between p-8 sm:p-10\">\n            <div>\n              <p className=\"text-6xl font-light tracking-tight sm:text-7xl\">BMW {seriesNo}</p>\n              <p className=\"mt-2 text-sm font-semibold uppercase tracking-[0.3em] text-white/80\">\n                Profile {letter(rank)} · {profile.name}\n              </p>\n              <p className=\"mt-4 max-w-sm text-white/75\">{profile.tagline}</p>\n            </div>\n            <div className=\"flex flex-wrap items-end justify-between gap-4 text-xs\">\n              <div className=\"flex flex-col gap-1\">\n                <span className=\"inline-flex items-center gap-2 font-semibold uppercase tracking-[0.2em]\">\n                  <span aria-hidden className=\"size-2.5 rounded-full\" style={{ backgroundColor: color.stroke }} />\n                  {scopeLabel} · {date}\n                </span>\n                <span className=\"text-white/55\">Dixi requirement profile · Session {session.id}</span>\n              </div>\n              {image && (\n                <a href={image.page} target=\"_blank\" rel=\"noreferrer\" className=\"text-white/50 hover:text-white hover:underline\">\n                  {image.credit} · modified\n                </a>\n              )}\n            </div>\n          </div>\n        </header>\n\n        <div className=\"flex flex-col gap-12 px-6 sm:px-10\">\n          {/* At a glance: like \"Fahrzeugpreise\" */}\n          <CatalogSection title=\"Profile at a glance\">\n            <div className=\"grid gap-8 md:grid-cols-2\">\n              <table className=\"w-full text-[13px]\">\n                <Band cols={2}>Score</Band>\n                <tbody>\n                  <Row label=\"L1 · Principles and your priority\" value={Math.round(profile.score.l1 * 100)} />\n                  <Row label=\"L2 · Evidence covered\" value={Math.round(profile.score.l2 * 100)} />\n                  <Row label={`L3 · Social test (max ${Math.round(cfg.l3Weight * 100)}%)`} value={profile.score.l3 === null ? \"not run\" : Math.round(profile.score.l3 * 100)} />\n                  <Row label=\"Total score\" value={Math.round(profile.score.total * 100)} strong />\n                </tbody>\n              </table>\n              <table className=\"w-full text-[13px]\">\n                <Band cols={2}>Scope</Band>\n                <tbody>\n                  <Row label=\"Series · market\" value={`${cfg.name} (${cfg.id}) · ${scopeLabel}`} />\n                  <Row label=\"Requirements\" value={profile.requests.length} />\n                  <Row label=\"Customer mentions covered\" value={covered.toLocaleString(\"en\")} />\n                  <Row label=\"From the wishlist\" value={profile.wishes.length} />\n                  <Row label=\"Related options today (EUR incl. VAT)\" value={listPrice(optionTotal || null)} strong />\n                </tbody>\n              </table>\n            </div>\n          </CatalogSection>\n\n          {/* Requirements matrix: like \"Sonderausstattungen\" */}\n          <CatalogSection title=\"Requirements\" note=\"In your priority order. Columns compare the three profiles of this session.\">\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full min-w-[640px] text-[13px]\">\n                <thead>\n                  <tr className=\"align-bottom text-[11px] text-muted\">\n                    <th className=\"pb-2 text-left font-normal\" />\n                    <th className=\"w-16 pb-2 text-left font-normal\">Code</th>\n                    <th className=\"w-28 pb-2 text-right font-normal\">Option today</th>\n                    {profiles.map((p, i) => (\n                      <th key={p.id} className=\"w-10 pb-2 font-normal\">\n                        <span\n                          className=\"mx-auto block h-28 w-4 rotate-180 text-left [writing-mode:vertical-rl]\"\n                          style={p.id === profile.id ? { color: \"var(--ink)\", fontWeight: 600 } : undefined}\n                        >\n                          Profile {letter(i)} · {p.name}\n                        </span>\n                      </th>\n                    ))}\n                  </tr>\n                </thead>\n                {CATEGORIES.map((cat) => {\n                  const list = rows.filter((r) => r.category === cat);\n                  if (!list.length) return null;\n                  const Icon = CATEGORY_ICON[cat];\n                  return (\n                    <tbody key={cat}>\n                      <tr>\n                        <td colSpan={3 + profiles.length} className=\"pt-5\">\n                          <p className=\"flex items-center gap-2 border-b border-ink/70 pb-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink\">\n                            <Icon aria-hidden className=\"size-3.5\" /> {cat}\n                          </p>\n                        </td>\n                      </tr>\n                      {list.map((r) => {\n                        const o = r.relatedOptions[0];\n                        const mine = included.has(r.id);\n                        return (\n                          <tr key={r.id} className={`border-b border-line align-top ${mine ? \"\" : \"text-muted\"}`}>\n                            <td className=\"py-2.5 pr-4\">\n                              <p className={mine ? \"font-medium text-ink\" : \"\"}>\n                                {r.title} <span className=\"text-[11px] font-normal text-muted\">#{r.priority}</span>\n                              </p>\n                              {mine && <p className=\"mt-0.5 text-[12px] text-ink-soft\">– {capitalise(draftTarget(r).replace(/^“[^”]+”: /, \"\"))}</p>}\n                              {mine && r.relatedOptions.length > 1 && (\n                                <p className=\"mt-0.5 text-[11px] text-muted\">\n                                  Also: {r.relatedOptions.slice(1).map((x) => `${x.code} ${x.name}`).join(\" · \")}\n                                </p>\n                              )}\n                            </td>\n                            <td className=\"py-2.5 font-mono text-[11px] text-muted\">{o ? o.code : r.id.split(\"-\")[1]}</td>\n                            <td className=\"py-2.5 text-right tabular-nums\">{o ? listPrice(o.priceEur) : <span className=\"text-line\">–</span>}</td>\n                            {profiles.map((p) => (\n                              <td key={p.id} className=\"py-2.5 text-center\">\n                                {mark(p, r.id)}\n                              </td>\n                            ))}\n                          </tr>\n                        );\n                      })}\n                    </tbody>\n                  );\n                })}\n                {wishes.size > 0 && (\n                  <tbody>\n                    <tr>\n                      <td colSpan={3 + profiles.length} className=\"pt-5\">\n                        <p className=\"flex items-center gap-2 border-b border-ink/70 pb-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink\">\n                          <Star aria-hidden className=\"size-3.5\" /> Wishlist · competitors &amp; trends\n                        </p>\n                      </td>\n                    </tr>\n                    {[...wishes.values()].map((w) => (\n                      <tr key={w.id} className=\"border-b border-line align-top\">\n                        <td className=\"py-2.5 pr-4\">\n                          <p className=\"font-medium text-ink\">{w.title}</p>\n                          <p className=\"mt-0.5 text-[12px] text-ink-soft\">\n                            – {w.kind === \"competitor\" ? `${w.competitor}: ` : \"\"}\n                            {w.detail}\n                          </p>\n                        </td>\n                        <td className=\"py-2.5 font-mono text-[11px] text-muted\">{w.id}</td>\n                        <td className=\"py-2.5 text-right text-line\">–</td>\n                        {profiles.map((p) => (\n                          <td key={p.id} className=\"py-2.5 text-center\">\n                            {mark(p, w.id, true)}\n                          </td>\n                        ))}\n                      </tr>\n                    ))}\n                  </tbody>\n                )}\n              </table>\n            </div>\n            <Legend />\n          </CatalogSection>\n\n          <div className=\"grid gap-12 lg:grid-cols-2\">\n            <CatalogSection title=\"Why this profile\">\n              <ol className=\"text-[13px]\">\n                {profile.why.map((w, i) => (\n                  <li key={w} className=\"flex gap-3 border-b border-line py-2.5\">\n                    <span className=\"w-4 shrink-0 tabular-nums text-muted\">{i + 1}</span>\n                    <span className=\"text-ink-soft\">{w}</span>\n                  </li>\n                ))}\n              </ol>\n            </CatalogSection>\n            <CatalogSection title=\"Principles\">\n              <table className=\"w-full text-[13px]\">\n                <tbody>\n                  {cfg.principles.map((p) => (\n                    <tr key={p.id} className=\"border-b border-line align-top\">\n                      <td className=\"w-10 py-2.5 font-mono text-[11px] font-semibold text-l1\">{p.id}</td>\n                      <td className=\"py-2.5 text-ink-soft\">{p.text}</td>\n                      <td className=\"py-2.5 pl-3 text-right text-[11px] text-muted\">{p.owner}</td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n              <p className=\"text-[11px] text-muted\">■ Every principle is respected by this profile.</p>\n            </CatalogSection>\n          </div>\n\n          <CatalogSection title=\"Competitors and trends\">\n            {signals.length === 0 ? (\n              <p className=\"text-[13px] text-muted\">No competitor or trend signal is linked to this profile.</p>\n            ) : (\n              <table className=\"w-full text-[13px]\">\n                <tbody>\n                  {signals.map(({ s, wish }) => {\n                    const Icon = wish ? Star : SIGNAL_ICON[s.kind];\n                    return (\n                      <tr key={s.id} className=\"border-b border-line align-top\">\n                        <td className=\"w-8 py-2.5\">\n                          <Icon aria-hidden className={`size-4 ${wish ? \"text-brand\" : \"text-l3\"}`} fill={wish ? \"currentColor\" : \"none\"} />\n                        </td>\n                        <td className=\"py-2.5 pr-4\">\n                          <p className=\"font-medium text-ink\">{s.kind === \"competitor\" ? `${s.competitor}: ${s.title}` : s.title}</p>\n                          <p className=\"text-ink-soft\">{s.detail}</p>\n                        </td>\n                        <td className=\"hidden w-36 py-2.5 text-[11px] text-muted sm:table-cell\">\n                          {wish ? \"Wishlist\" : `Backs ${s.relatesTo.length} request${s.relatesTo.length > 1 ? \"s\" : \"\"}`}\n                        </td>\n                        <td className=\"w-44 py-2.5 text-right text-[11px]\">\n                          {s.sources.slice(0, 1).map((src) => (\n                            <a key={src.url} href={src.url} target=\"_blank\" rel=\"noreferrer\" className=\"inline-flex items-center gap-0.5 text-brand hover:underline\">\n                              {src.label}\n                              <ExternalLink aria-hidden className=\"size-3\" />\n                            </a>\n                          ))}\n                        </td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            )}\n          </CatalogSection>\n\n          <CatalogSection title=\"Decision trail\">\n            {rejected.length === 0 && keptOut.length === 0 ? (\n              <p className=\"text-[13px] text-muted\">No rejections. Every request you kept is in this profile.</p>\n            ) : (\n              <table className=\"w-full text-[13px]\">\n                <tbody>\n                  {rejected.map((d) => (\n                    <tr key={d.requestId} className=\"border-b border-line align-top\">\n                      <td className=\"w-24 py-2.5 text-[11px] font-semibold uppercase tracking-wider text-bad\">Rejected</td>\n                      <td className=\"py-2.5 pr-4\">\n                        <p className=\"font-medium text-ink\">{d.title}</p>\n                        <p className=\"text-ink-soft\">“{d.reason}”</p>\n                      </td>\n                      <td className=\"w-44 py-2.5 text-right text-[11px] text-muted\">\n                        {d.by}\n                        <br />\n                        {new Date(d.at).toLocaleString(\"en-GB\", { dateStyle: \"medium\", timeStyle: \"short\" })}\n                      </td>\n                    </tr>\n                  ))}\n                  {keptOut.map((d) => (\n                    <tr key={d.requestId} className=\"border-b border-line align-top\">\n                      <td className=\"w-24 py-2.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Kept</td>\n                      <td className=\"py-2.5 text-ink-soft\" colSpan={2}>\n                        {d.title} <span className=\"text-muted\">· in another profile</span>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            )}\n          </CatalogSection>\n\n          <footer className=\"border-t border-line pt-4 text-[11px] leading-relaxed text-muted\">\n            <Legend />\n            <p className=\"mt-2\">\n              Evidence: BMW customer feedback, customer studies, sales and the German option list (July 2026, EUR incl. 19% VAT). Competitor and trend signals link their\n              public sources. Principles and competitor notes are example content; the social test is simulated. {image && `${image.credit}, modified.`}\n            </p>\n          </footer>\n        </div>\n      </article>\n    </div>\n  );\n}\n\n/* ---------- catalogue building blocks ---------- */\n\nfunction CatalogSection({ title, note, children }: { title: string; note?: string; children: React.ReactNode }) {\n  return (\n    <section className=\"flex flex-col gap-4\">\n      <div>\n        <h2 className=\"text-xl font-semibold uppercase tracking-tight text-ink sm:text-2xl\">{title}.</h2>\n        {note && <p className=\"mt-1 text-[12px] text-muted\">{note}</p>}\n      </div>\n      {children}\n    </section>\n  );\n}\n\nfunction Band({ cols, children }: { cols: number; children: React.ReactNode }) {\n  return (\n    <thead>\n      <tr>\n        <th colSpan={cols} className=\"bg-bg-soft px-3 py-2 text-left text-xs font-semibold uppercase tracking-[0.12em] text-ink\">\n          {children}\n        </th>\n      </tr>\n    </thead>\n  );\n}\n\nfunction Row({ label, value, strong }: { label: string; value: React.ReactNode; strong?: boolean }) {\n  return (\n    <tr className=\"border-b border-line\">\n      <td className={`px-3 py-2 ${strong ? \"font-semibold uppercase tracking-wide text-ink\" : \"text-ink-soft\"}`}>{label}</td>\n      <td className={`px-3 py-2 text-right tabular-nums ${strong ? \"font-semibold text-ink\" : \"text-ink\"}`}>{value}</td>\n    </tr>\n  );\n}\n\nfunction Legend() {\n  return (\n    <p className=\"flex flex-wrap gap-x-6 gap-y-1 text-[11px] text-muted\">\n      <span>■ In this profile</span>\n      <span>□ In another profile</span>\n      <span>– Not included</span>\n      <span>–,– Included or no price on today&apos;s option list</span>\n    </p>\n  );\n}\n","structuredPatch":[{"oldStart":1,"oldLines":37,"newStart":1,"newLines":42,"lines":[" \"use client\";"," ","-import { ArrowLeft, ArrowRight, Check, Download, ExternalLink, ListChecks, MessageSquareText, Radar, ShieldCheck, Star, Tag, Trophy, X } from \"lucide-react\";","+import Image from \"next/image\";","+import { ArrowLeft, ArrowRight, Download, ExternalLink, Star, Trophy } from \"lucide-react\";"," import type { CarImage } from \"@/lib/car-images\";"," import { draftTarget, type Decisions, type Profile } from \"@/lib/pipeline/profiles\";"," import type { SeriesConfig } from \"@/lib/pipeline/series\";","-import { BannerStat, CarBanner } from \"./CarBanner\";","+import type { Session } from \"@/lib/pipeline/sessions\";","+import { CATEGORIES, type FeatureRequest, type MarketSignal } from \"@/lib/pipeline/types\";"," import { PROFILE_COLOR } from \"./Analytics\";","-import { CategoryTile, SIGNAL_ICON } from \"./icons\";","-import { euro } from \"./RequestCard\";","+import { CATEGORY_ICON, SIGNAL_ICON } from \"./icons\";"," ","-/** Stacked bar: how much each layer contributes to a profile's score. */","-export function LayerScore({ score, l3Weight }: { score: Profile[\"score\"]; l3Weight: number }) {","+const layerParts = (score: Profile[\"score\"], l3Weight: number) => {","   const w3 = score.l3 === null ? 0 : l3Weight;","   const w1 = 0.45 * (1 - w3);","   const w2 = 1 - w1 - w3;","-  const parts = [","+  return [","     { id: \"L1\", cls: \"bg-l1\", v: w1 * score.l1, label: \"principles\" },","     { id: \"L2\", cls: \"bg-l2\", v: w2 * score.l2, label: \"evidence\" },","     { id: \"L3\", cls: \"bg-l3\", v: w3 * (score.l3 ?? 0), label: \"social test\" },","   ];","+};","+","+/** Stacked bar: how much each layer contributes to a profile's score. */","+export function LayerScore({ score, l3Weight, dark }: { score: Profile[\"score\"]; l3Weight: number; dark?: boolean }) {","+  const parts = layerParts(score, l3Weight);","   const pct = Math.round(score.total * 100);","   return (","     <div className=\"flex items-center gap-3\">","       <div","         role=\"img\"","         aria-label={`Score ${pct} of 100: ${parts.map((p) => `${p.label} ${Math.round(p.v * 100)}`).join(\", \")}`}","-        className=\"flex h-2 flex-1 overflow-hidden rounded-full bg-bg-soft ring-1 ring-inset ring-line\"","+        className={`flex h-2 flex-1 overflow-hidden rounded-full ${dark ? \"bg-white/10\" : \"bg-bg-soft ring-1 ring-inset ring-line\"}`}","       >","         {parts.map((p) => (","-          <span key={p.id} className={`h-full ${p.cls}`} style={{ width: `${p.v * 100}%` }} />","+          <span key={p.id} className={`h-full ${dark && p.id === \"L1\" ? \"bg-brand-sky\" : p.cls}`} style={{ width: `${p.v * 100}%` }} />","         ))}","       </div>","-      <span aria-hidden className=\"w-7 text-right text-sm font-semibold tabular-nums text-ink\">","+      <span aria-hidden className={`w-7 text-right text-sm font-semibold tabular-nums ${dark ? \"text-white\" : \"text-ink\"}`}>","         {pct}","       </span>","     </div>"]},{"oldStart":40,"oldLines":87,"newStart":45,"newLines":138,"lines":[" "," const letter = (i: number) => String.fromCharCode(65 + i);"," const capitalise = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);","+/** Price in the option-list style: 1.900,– */","+const listPrice = (n: number | null) => (n === null ? \"–,–\" : `${n.toLocaleString(\"de-DE\")},–`);"," ","-export function ProfileList({ profiles, cfg, onOpen }: { profiles: Profile[]; cfg: SeriesConfig; onOpen: (id: string) => void }) {","+/* ---------- dashboard cards ---------- */","+","+export function ProfileList({ profiles, cfg, image, onOpen }: { profiles: Profile[]; cfg: SeriesConfig; image?: CarImage; onOpen: (id: string) => void }) {","   return (","-    <ul className=\"grid gap-4 lg:grid-cols-3\">","-      {profiles.map((p, i) => (","-        <li key={p.id}>","-          <article className={`flex h-full flex-col rounded-card border bg-surface p-5 shadow-card ${i === 0 ? \"border-brand/50 ring-2 ring-brand/10\" : \"border-line\"}`}>","-            <div className=\"flex items-center justify-between gap-3\">","-              <p className=\"flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-muted\">","-                <span aria-hidden className={`size-2.5 rounded-full ${PROFILE_COLOR[p.id].bg}`} />","-                Profile {letter(i)}","-              </p>","-              {i === 0 && (","-                <span className=\"inline-flex items-center gap-1 rounded-full bg-brand-soft px-2 py-0.5 text-xs font-medium text-brand-deep\">","-                  <Trophy aria-hidden className=\"size-3\" /> Best fit","-                </span>","-              )}","-            </div>","-            <h3 className=\"mt-1.5 text-lg font-semibold tracking-tight text-ink\">{p.name}</h3>","-            <p className=\"text-sm text-ink-soft\">{p.tagline}</p>","-            <div className=\"mt-4\">","-              <LayerScore score={p.score} l3Weight={cfg.l3Weight} />","-            </div>","-            <ul className=\"mt-4 flex flex-1 flex-col gap-2 text-sm\">","-              {p.requests.slice(0, 5).map((r) => (","-                <li key={r.id} className=\"flex items-center gap-2.5\">","-                  <CategoryTile category={r.category} size=\"sm\" />","-                  <span className=\"min-w-0 flex-1 truncate text-ink-soft\">{r.title}</span>","-                  <span className=\"shrink-0 text-xs tabular-nums text-muted\">#{r.priority}</span>","-                </li>","-              ))}","-              {p.wishes.map((w) => (","-                <li key={w.id} className=\"flex items-center gap-2.5\">","-                  <span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-brand-soft text-brand\">","-                    <Star aria-hidden className=\"size-3.5\" fill=\"currentColor\" />","-                  </span>","-                  <span className=\"min-w-0 flex-1 truncate text-brand-deep\">{w.title}</span>","-                </li>","-              ))}","-            </ul>","+    <ul className=\"grid gap-5 lg:grid-cols-3\">","+      {profiles.map((p, i) => {","+        const color = PROFILE_COLOR[p.id];","+        return (","+          <li key={p.id}>","             <button","               type=\"button\"","               onClick={() => onOpen(p.id)}","-              className=\"mt-5 inline-flex h-10 items-center justify-center gap-1.5 rounded-full text-sm font-medium text-ink ring-1 ring-line transition-colors hover:bg-bg-soft hover:ring-brand/30\"","+              className=\"group flex h-full w-full flex-col overflow-hidden rounded-[22px] bg-ink text-left text-white shadow-card ring-1 ring-line transition-[box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-float motion-reduce:transition-none motion-reduce:hover:translate-y-0\"","             >","-              Open profile <ArrowRight aria-hidden className=\"size-4\" />","+              <div className=\"relative aspect-[16/9] overflow-hidden\">","+                {image && (","+                  <Image","+                    src={image.src}","+                    alt=\"\"","+                    fill","+                    sizes=\"(min-width: 1024px) 30vw, 100vw\"","+                    className=\"object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none\"","+                  />","+                )}","+                {/* tint the photo in the profile's colour, then fade into the card */}","+                <div aria-hidden className=\"absolute inset-0 opacity-35 mix-blend-color\" style={{ backgroundColor: color.stroke }} />","+                <div aria-hidden className=\"absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink to-transparent\" />","+                <span className=\"absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-2.5 py-1 text-xs font-semibold tracking-wider ring-1 ring-white/20 backdrop-blur-md\">","+                  <span aria-hidden className=\"size-2 rounded-full\" style={{ backgroundColor: color.stroke }} />","+                  PROFILE {letter(i)}","+                </span>","+                {i === 0 && (","+                  <span className=\"absolute right-4 top-4 inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-ink\">","+                    <Trophy aria-hidden className=\"size-3.5 text-brand\" /> Best fit","+                  </span>","+                )}","+              </div>","+","+              <div className=\"-mt-4 flex flex-1 flex-col gap-4 p-5 pt-0\">","+                <div className=\"relative\">","+                  <h3 className=\"text-2xl font-semibold tracking-tight\">{p.name}</h3>","+                  <p className=\"text-sm text-white/65\">{p.tagline}</p>","+                </div>","+                <LayerScore score={p.score} l3Weight={cfg.l3Weight} dark />","+                <ul className=\"flex flex-col gap-2 text-sm\">","+                  {p.requests.slice(0, 4).map((r) => {","+                    const Icon = CATEGORY_ICON[r.category];","+                    return (","+                      <li key={r.id} className=\"flex items-center gap-2.5\">","+                        <span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-white/10\">","+                          <Icon aria-hidden className=\"size-3.5 text-brand-sky\" />","+                        </span>","+                        <span className=\"min-w-0 flex-1 truncate text-white/85\">{r.title}</span>","+                        <span className=\"shrink-0 text-xs tabular-nums text-white/45\">#{r.priority}</span>","+                      </li>","+                    );","+                  })}","+                  {p.wishes.map((w) => (","+                    <li key={w.id} className=\"flex items-center gap-2.5\">","+                      <span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-white/10\">","+                        <Star aria-hidden className=\"size-3.5 text-brand-sky\" fill=\"currentColor\" />","+                      </span>","+                      <span className=\"min-w-0 flex-1 truncate text-white/85\">{w.title}</span>","+                    </li>","+                  ))}","+                </ul>","+                <span className=\"mt-auto inline-flex h-10 items-center justify-between rounded-full bg-white px-4 text-sm font-medium text-ink transition-colors group-hover:bg-brand group-hover:text-white\">","+                  Open profile","+                  <ArrowRight aria-hidden className=\"size-4 transition-transform group-hover:translate-x-0.5\" />","+                </span>","+              </div>","             </button>","-          </article>","-        </li>","-      ))}","+          </li>","+        );","+      })}","     </ul>","   );"," }"," ","+/* ---------- profile page: laid out like BMW's option-list catalogue ---------- */","+"," export function ProfileDetail({","   profile,","+  profiles,","   rank,","   cfg,","   scopeLabel,","   decisions,","+  session,","   image,","   onBack,"," }: {","   profile: Profile;","+  /** All profiles of the session, for the comparison columns. */","+  profiles: Profile[];","   rank: number;","   cfg: SeriesConfig;","   scopeLabel: string;","   decisions: Decisions;","+  session: Session;","   image?: CarImage;","   onBack: () => void;"," }) {","+  const color = PROFILE_COLOR[profile.id];","   const included = new Set(profile.requests.map((r) => r.id));","   const all = Object.values(decisions);","   const rejected = all.filter((d) => d.action === \"reject\");","   const keptOut = all.filter((d) => d.action === \"keep\" && !included.has(d.requestId));","+","+  /* Every requirement of the session, so the matrix compares this profile with the others. */","+  const union = new Map<string, FeatureRequest & { scoped: number; priority: number }>();","+  profiles.forEach((p) => p.requests.forEach((r) => union.set(r.id, r)));","+  const rows = [...union.values()].sort((a, b) => a.priority - b.priority);","+  const wishes = new Map<string, MarketSignal>();","+  profiles.forEach((p) => p.wishes.forEach((w) => wishes.set(w.id, w)));","+","   const options = profile.requests.flatMap((r) => r.relatedOptions);","   const optionTotal = options.reduce((s, o) => s + (o.priceEur ?? 0), 0);","   const covered = profile.requests.reduce((s, r) => s + r.scoped, 0);","   const signals = [...profile.wishes.map((s) => ({ s, wish: true })), ...profile.backing.filter((b) => !profile.wishes.includes(b)).map((s) => ({ s, wish: false }))];","-  const today = new Date().toLocaleDateString(\"en-GB\", { dateStyle: \"long\" });","+  const date = new Date(session.createdAt).toLocaleDateString(\"en-GB\", { month: \"long\", year: \"numeric\" }).toUpperCase();","+  const seriesNo = cfg.name.split(\" \")[0];"," ","+  const mark = (p: Profile, id: string, isWish = false) => {","+    const has = isWish ? p.wishes.some((w) => w.id === id) : p.requests.some((r) => r.id === id);","+    if (!has) return <span className=\"text-line\">–</span>;","+    return p.id === profile.id ? <span title=\"In this profile\">■</span> : <span title=\"In another profile\" className=\"text-muted\">□</span>;","+  };","+","   return (","     <div className=\"flex flex-col gap-5\">","       <div data-no-print className=\"flex items-center justify-between gap-3\">"]},{"oldStart":137,"oldLines":183,"newStart":193,"newLines":311,"lines":["         </button>","       </div>"," ","-      <div data-print-root className=\"flex flex-col gap-5\">","-        <div data-print-only className=\"mb-2 border-b border-line pb-3\">","-          <p className=\"text-lg font-semibold text-brand-deep\">Dixi · Profile report</p>","-          <p className=\"text-xs text-muted\">","-            {cfg.name} · {scopeLabel} · Profile {letter(rank)} · {today}","-          </p>","-        </div>","-","-        <CarBanner image={image}>","-          <p className=\"flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-brand-sky\">","-            <span aria-hidden className={`size-2.5 rounded-full ${PROFILE_COLOR[profile.id].bg}`} />","-            Profile {letter(rank)} · {cfg.name} · {scopeLabel}","-          </p>","-          <h2 className=\"text-3xl font-semibold tracking-tight sm:text-4xl\">{profile.name}</h2>","-          <p className=\"text-white/70\">{profile.tagline}</p>","-          <div className=\"mt-1 flex flex-wrap gap-2\">","-            <BannerStat value={Math.round(profile.score.total * 100)} label=\"score\" />","-            <BannerStat value={Math.round(profile.score.l1 * 100)} label=\"L1 fit\" />","-            <BannerStat value={Math.round(profile.score.l2 * 100)} label=\"L2 coverage\" />","-            <BannerStat value={profile.score.l3 === null ? \"–\" : Math.round(profile.score.l3 * 100)} label=\"L3 social\" />","+      <article data-print-root className=\"flex flex-col gap-12 rounded-[22px] border border-line bg-surface pb-10 shadow-card print:border-0\">","+        {/* Cover */}","+        <header className=\"relative isolate min-h-[440px] overflow-hidden rounded-t-[22px] bg-ink text-white\">","+          {image && <Image src={image.src} alt={image.alt} fill loading=\"eager\" sizes=\"(min-width: 1024px) 70vw, 100vw\" className=\"-z-10 object-cover\" />}","+          <div aria-hidden className=\"absolute inset-0 -z-10 bg-gradient-to-r from-ink/85 via-ink/30 to-transparent\" />","+          <div aria-hidden className=\"absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-ink/80 to-transparent\" />","+          <div className=\"flex min-h-[440px] flex-col justify-between p-8 sm:p-10\">","+            <div>","+              <p className=\"text-6xl font-light tracking-tight sm:text-7xl\">BMW {seriesNo}</p>","+              <p className=\"mt-2 text-sm font-semibold uppercase tracking-[0.3em] text-white/80\">","+                Profile {letter(rank)} · {profile.name}","+              </p>","+              <p className=\"mt-4 max-w-sm text-white/75\">{profile.tagline}</p>","+            </div>","+            <div className=\"flex flex-wrap items-end justify-between gap-4 text-xs\">","+              <div className=\"flex flex-col gap-1\">","+                <span className=\"inline-flex items-center gap-2 font-semibold uppercase tracking-[0.2em]\">","+                  <span aria-hidden className=\"size-2.5 rounded-full\" style={{ backgroundColor: color.stroke }} />","+                  {scopeLabel} · {date}","+                </span>","+                <span className=\"text-white/55\">Dixi requirement profile · Session {session.id}</span>","+              </div>","+              {image && (","+                <a href={image.page} target=\"_blank\" rel=\"noreferrer\" className=\"text-white/50 hover:text-white hover:underline\">","+                  {image.credit} · modified","+                </a>","+              )}","+            </div>","           </div>","-        </CarBanner>","+        </header>"," ","-        <dl className=\"grid grid-cols-2 gap-3 md:grid-cols-4\">","-          <Kpi icon={<ListChecks aria-hidden className=\"size-4\" />} label=\"Requirements\" value={profile.requests.length} />","-          <Kpi icon={<MessageSquareText aria-hidden className=\"size-4\" />} label=\"Customer mentions covered\" value={covered.toLocaleString(\"en\")} />","-          <Kpi icon={<Tag aria-hidden className=\"size-4\" />} label=\"Related options today\" value={optionTotal ? euro(optionTotal) : \"–\"} />","-          <Kpi icon={<Star aria-hidden className=\"size-4\" />} label=\"From your wishlist\" value={profile.wishes.length} />","-        </dl>","+        <div className=\"flex flex-col gap-12 px-6 sm:px-10\">","+          {/* At a glance: like \"Fahrzeugpreise\" */}","+          <CatalogSection title=\"Profile at a glance\">","+            <div className=\"grid gap-8 md:grid-cols-2\">","+              <table className=\"w-full text-[13px]\">","+                <Band cols={2}>Score</Band>","+                <tbody>","+                  <Row label=\"L1 · Principles and your priority\" value={Math.round(profile.score.l1 * 100)} />","+                  <Row label=\"L2 · Evidence covered\" value={Math.round(profile.score.l2 * 100)} />","+                  <Row label={`L3 · Social test (max ${Math.round(cfg.l3Weight * 100)}%)`} value={profile.score.l3 === null ? \"not run\" : Math.round(profile.score.l3 * 100)} />","+                  <Row label=\"Total score\" value={Math.round(profile.score.total * 100)} strong />","+                </tbody>","+              </table>","+              <table className=\"w-full text-[13px]\">","+                <Band cols={2}>Scope</Band>","+                <tbody>","+                  <Row label=\"Series · market\" value={`${cfg.name} (${cfg.id}) · ${scopeLabel}`} />","+                  <Row label=\"Requirements\" value={profile.requests.length} />","+                  <Row label=\"Customer mentions covered\" value={covered.toLocaleString(\"en\")} />","+                  <Row label=\"From the wishlist\" value={profile.wishes.length} />","+                  <Row label=\"Related options today (EUR incl. VAT)\" value={listPrice(optionTotal || null)} strong />","+                </tbody>","+              </table>","+            </div>","+          </CatalogSection>"," ","-        <Section title=\"Requirements\" hint=\"In your priority order\">","-          <ol className=\"divide-y divide-line\">","-            {profile.requests.map((r) => (","-              <li key={r.id} className=\"grid grid-cols-[2.25rem_1fr] gap-3 px-5 py-3.5 sm:grid-cols-[2.25rem_1fr_auto]\">","-                <CategoryTile category={r.category} size=\"sm\" />","-                <div className=\"min-w-0\">","-                  <p className=\"flex flex-wrap items-baseline gap-x-2 font-medium text-ink\">","-                    <span className=\"text-xs tabular-nums text-muted\">#{r.priority}</span>","-                    {r.title}","-                  </p>","-                  <p className=\"mt-0.5 text-sm text-ink-soft\">{capitalise(draftTarget(r).replace(/^“[^”]+”: /, \"\"))}</p>","-                  {r.relatedOptions.length > 0 && (","-                    <p className=\"mt-1 flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-muted\">","-                      {r.relatedOptions.map((o) => (","-                        <span key={o.code} className=\"inline-flex items-center gap-1\">","-                          <Tag aria-hidden className=\"size-3\" />","-                          <span className=\"font-mono\">{o.code}</span> {o.name} · {o.priceEur === null ? \"included\" : euro(o.priceEur)}","+          {/* Requirements matrix: like \"Sonder