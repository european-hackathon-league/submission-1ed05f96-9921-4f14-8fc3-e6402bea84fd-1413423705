le: \"Dashboard · Dixi\" };"," ","-export default function DashboardPickerPage() {","+export default function DashboardPage() {","   return (","     <>","       <TopBar />","-      <main className=\"flex-1 bg-bg-soft\">","-        <MarketPicker />","+      <main className=\"flex-1\">","+        <DashboardHome />","       </main>","     </>","   );"]}]},{"filePath":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/app/dashboard/sessions/page.tsx","hunks":[{"oldStart":1,"oldLines":21,"newStart":0,"newLines":0,"lines":["-import type { Metadata } from \"next\";","-import { TopBar } from \"@/components/dashboard/TopBar\";","-import { AllSessions } from \"@/components/pipeline/AllSessions\";","-","-export const metadata: Metadata = { title: \"Sessions · Dixi\" };","-","-export default function SessionsPage() {","-  return (","-    <>","-      <TopBar />","-      <main className=\"mx-auto w-full max-w-4xl flex-1 px-4 pb-16 pt-8 sm:px-6\">","-        <p className=\"text-xs font-semibold uppercase tracking-[0.14em] text-brand\">History</p>","-        <h1 className=\"mt-1 text-3xl font-semibold tracking-tight text-ink\">Sessions</h1>","-        <p className=\"mt-1 text-sm text-muted\">Every generation of profiles you built. Open one to see its profiles, analytics and decisions again.</p>","-        <div className=\"mt-6\">","-          <AllSessions />","-        </div>","-      </main>","-    </>","-  );","-}"]}],"deleted":true},{"filePath":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/dashboard/DashboardHome.tsx","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":130,"lines":["+\"use client\";","+","+import { FolderClock, Globe2, Layers, ListChecks, Plus, Trophy } from \"lucide-react\";","+import { useEffect, useState } from \"react\";","+import { GenerationList } from \"@/components/pipeline/Generations\";","+import { deleteSession, readSessions, type Session } from \"@/lib/pipeline/sessions\";","+import { MarketPicker } from \"./MarketPicker\";","+","+type Tab = \"generations\" | \"new\";","+","+/** The dashboard home: earlier generations of profiles, or a new analysis (globe → series → pipeline).","+ *  Generations live in this browser, so the tab is chosen once they are read (#new opens the globe). */","+export function DashboardHome() {","+  const [gens, setGens] = useState<Session[] | null>(null);","+  const [tab, setTab] = useState<Tab | null>(null);","+","+  useEffect(() => {","+    const t = setTimeout(() => {","+      const list = readSessions();","+      setGens(list);","+      setTab(window.location.hash === \"#new\" || list.length === 0 ? \"new\" : \"generations\");","+    }, 0);","+    const onHash = () => setTab(window.location.hash === \"#new\" ? \"new\" : \"generations\");","+    window.addEventListener(\"hashchange\", onHash);","+    return () => {","+      clearTimeout(t);","+      window.removeEventListener(\"hashchange\", onHash);","+    };","+  }, []);","+","+  const go = (t: Tab) => {","+    setTab(t);","+    history.replaceState(null, \"\", t === \"new\" ? \"#new\" : window.location.pathname);","+  };","+","+  const list = gens ?? [];","+  const decisions = list.reduce((n, g) => n + Object.keys(g.decisions).length, 0);","+  const combos = new Set(list.map((g) => `${g.series}-${g.scope}`)).size;","+  const best = list.flatMap((g) => g.profiles.map((p) => ({ g, p }))).sort((a, b) => b.p.score.total - a.p.score.total)[0];","+","+  return (","+    <div className=\"mx-auto flex w-full max-w-[1200px] flex-col gap-6 px-4 pb-16 pt-6 sm:px-6\">","+      <div className=\"flex flex-wrap items-end justify-between gap-3\">","+        <div>","+          <p className=\"text-xs font-semibold uppercase tracking-[0.14em] text-brand\">Dashboard</p>","+          <h1 className=\"mt-1 text-3xl font-semibold tracking-tight text-ink\">{tab === \"new\" ? \"New analysis\" : \"Generations\"}</h1>","+        </div>","+        <div role=\"tablist\" aria-label=\"Dashboard\" className=\"inline-flex rounded-full bg-surface p-1 shadow-card ring-1 ring-line\">","+          {(","+            [","+              [\"generations\", \"Generations\", FolderClock, list.length],","+              [\"new\", \"New analysis\", Plus, null],","+            ] as const","+          ).map(([id, label, Icon, count]) => (","+            <button","+              key={id}","+              role=\"tab\"","+              type=\"button\"","+              aria-selected={tab === id}","+              onClick={() => go(id)}","+              className={`inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm transition-colors ${","+                tab === id ? (id === \"new\" ? \"bg-brand font-medium text-white\" : \"bg-ink font-medium text-white\") : \"text-ink-soft hover:text-ink\"","+              }`}","+            >","+              <Icon aria-hidden className=\"size-4\" />","+              {label}","+              {count !== null && gens && <span className=\"tabular-nums opacity-60\">{count}</span>}","+            </button>","+          ))}","+        </div>","+      </div>","+","+      {tab === null && <div className=\"h-64 animate-pulse rounded-card bg-surface ring-1 ring-line\" />}","+","+      {tab === \"generations\" && (","+        <>","+          <dl className=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">","+            <Kpi icon={<FolderClock aria-hidden className=\"size-4\" />} label=\"Generations\" value={list.length} />","+            <Kpi icon={<Globe2 aria-hidden className=\"size-4\" />} label=\"Cars × markets\" value={combos} />","+            <Kpi icon={<ListChecks aria-hidden className=\"size-4\" />} label=\"Decisions logged\" value={decisions} />","+            <Kpi","+              icon={<Trophy aria-hidden className=\"size-4\" />}","+              label={best ? `Top profile · ${best.g.seriesName} ${best.g.scopeLabel}` : \"Top profile\"}","+              value={best ? `${best.p.name} ${Math.round(best.p.score.total * 100)}` : \"–\"}","+              small","+            />","+          </dl>","+          {list.length === 0 ? (","+            <div className=\"flex flex-col items-center gap-3 rounded-card border border-dashed border-line bg-surface p-10 text-center\">","+              <Layers aria-hidden className=\"size-6 text-muted\" />","+              <p className=\"text-sm text-muted\">No generations yet. Run an analysis and build profiles; each build is saved here.</p>","+              <button type=\"button\" onClick={() => go(\"new\")} className=\"h-10 rounded-full bg-brand px-5 text-sm font-medium text-white shadow-card hover:bg-brand-deep\">","+                Start a new analysis","+              </button>","+            </div>","+          ) : (","+            <>","+              <GenerationList","+                generations={list}","+                onDelete={(id) => {","+                  deleteSession(id);","+                  setGens(readSessions());","+                }}","+              />","+              <p className=\"text-xs text-muted\">Saved in this browser. Each build of profiles is one generation: its decisions, priority, profiles and social test.</p>","+            </>","+          )}","+        </>","+      )}","+","+      {tab === \"new\" && (","+        <div className=\"-mx-4 rounded-[22px] bg-bg-soft sm:-mx-6\">","+          <MarketPicker />","+        </div>","+      )}","+    </div>","+  );","+}","+","+function Kpi({ icon, label, value, small }: { icon: React.ReactNode; label: string; value: React.ReactNode; small?: boolean }) {","+  return (","+    <div className=\"rounded-card border border-line bg-surface p-4 shadow-card\">","+      <dt className=\"flex items-center gap-1.5 truncate text-xs text-muted\">","+        {icon}","+        {label}","+      </dt>","+      <dd className={`mt-1 truncate font-semibold tracking-tight tabular-nums text-ink ${small ? \"text-lg\" : \"text-3xl\"}`}>{value}</dd>","+    </div>","+  );","+}"]}],"created":true},{"filePath":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/dashboard/TopBar.tsx","hunks":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":5,"lines":[" import Link from \"next/link\";","-import { FolderClock } from \"lucide-react\";","+import { Plus } from \"lucide-react\";"," import { Logo } from \"@/components/brand/Logo\";"," "," /** Minimal app bar: logo home, section label, sample-data badge. */"]},{"oldStart":14,"oldLines":8,"newStart":14,"newLines":8,"lines":["         <Link href=\"/dashboard\" className=\"text-sm font-medium text-ink-soft hover:text-ink\">","           Dashboard","         </Link>","-        <Link href=\"/dashboard/sessions\" className=\"ml-auto inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm text-ink-soft ring-1 ring-line hover:bg-bg-soft hover:text-ink\">","-          <FolderClock aria-hidden className=\"size-4\" /> Sessions","+        <Link href=\"/dashboard#new\" className=\"ml-auto inline-flex items-center gap-1.5 rounded-full bg-brand px-3.5 py-1.5 text-sm font-medium text-white shadow-card hover:bg-brand-deep\">","+          <Plus aria-hidden className=\"size-4\" /> New analysis","         </Link>","       </div>","     </header>"]}]}],"moreFiles":4,"changedFiles":["/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/app/dashboard/generations/page.tsx","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/app/dashboard/page.tsx","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/app/dashboard/sessions/page.tsx","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/dashboard/DashboardHome.tsx","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/dashboard/TopBar.tsx","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/pipeline/AllSessions.tsx","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/pipeline/GenerationPage.tsx","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/pipeline/Generations.tsx