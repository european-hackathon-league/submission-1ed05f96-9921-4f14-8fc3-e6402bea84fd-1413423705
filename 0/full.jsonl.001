q.id) onDropOn(id, where);\n      }}\n      className={`relative scroll-mt-24 rounded-xl border bg-surface shadow-card transition-[border-color,box-shadow,opacity,transform,background-color] duration-300 ${frame} ${\n        dragging ? \"scale-[0.98] border-dashed border-brand/50 opacity-40\" : \"\"\n      } ${flash ? \"!border-brand bg-brand-soft ring-4 ring-brand/15\" : \"\"}`}\n    >\n      {over && !dragging && (\n        <span aria-hidden className={`pointer-events-none absolute inset-x-1 z-10 flex items-center ${over === \"before\" ? \"-top-[5px]\" : \"-bottom-[5px]\"}`}>\n          <span className=\"size-2.5 rounded-full border-2 border-brand bg-surface\" />\n          <span className=\"h-0.5 flex-1 rounded-full bg-brand\" />\n        </span>\n      )}\n'''+s[b:]\nrep('''          onDragStart={(e) => {\n            e.dataTransfer.setData(\"text/plain\", req.id);\n            e.dataTransfer.effectAllowed = \"move\";\n          }}''','''          onDragStart={(e) => {\n            e.dataTransfer.setData(\"text/plain\", req.id);\n            e.dataTransfer.effectAllowed = \"move\";\n            if (liRef.current) e.dataTransfer.setDragImage(liRef.current, 24, 20);\n            onDragState(true);\n          }}\n          onDragEnd={() => onDragState(false)}''')\nopen(p,'w').write(s)\n\np='src/components/pipeline/Pipeline.tsx'; s=open(p).read()\ndef rep2(a,b):\n    global s\n    assert a in s, a[:90]; s=s.replace(a,b,1)\nrep2('import { useCallback, useEffect, useMemo, useState } from \"react\";','import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from \"react\";')\nrep2('''  const moveBefore = (dragged: string, target: string) => {\n    const ids = rows.map((r) => r.req.id).filter((id) => id !== dragged);\n    ids.splice(ids.indexOf(target), 0, dragged);\n    saveOrder(ids);\n  };''','''  /* Feedback while reordering: the dragged row dims, the moved row flashes, and rows slide to their new place (FLIP). */\n  const [dragging, setDragging] = useState<string | null>(null);\n  const [flash, setFlash] = useState<string | null>(null);\n  const flashTimer = useRef<ReturnType<typeof setTimeout> | null>(null);\n  const markMoved = (id: string) => {\n    setFlash(id);\n    if (flashTimer.current) clearTimeout(flashTimer.current);\n    flashTimer.current = setTimeout(() => setFlash(null), 900);\n  };\n  const listRef = useRef<HTMLUListElement>(null);\n  const positions = useRef(new Map<string, number>());\n  const orderKey = rows.map((r) => r.req.id).join();\n  useLayoutEffect(() => {\n    const ul = listRef.current;\n    if (!ul) return;\n    const reduce = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n    const next = new Map<string, number>();\n    ul.querySelectorAll<HTMLElement>(\"[data-req]\").forEach((el) => {\n      const id = el.dataset.req!;\n      const top = el.getBoundingClientRect().top;\n      next.set(id, top);\n      const before = positions.current.get(id);\n      if (!reduce && before !== undefined && Math.abs(before - top) > 1) {\n        el.animate([{ transform: `translateY(${before - top}px)` }, { transform: \"translateY(0)\" }], { duration: 260, easing: \"cubic-bezier(.2,.8,.2,1)\" });\n      }\n    });\n    positions.current = next;\n  }, [orderKey]);\n\n  const moveBefore = (dragged: string, target: string, where: \"before\" | \"after\" = \"before\") => {\n    const ids = rows.map((r) => r.req.id).filter((id) => id !== dragged);\n    ids.splice(ids.indexOf(target) + (where === \"after\" ? 1 : 0), 0, dragged);\n    saveOrder(ids);\n    markMoved(dragged);\n  };''')\nrep2('''    [ids[a], ids[b]] = [ids[b], ids[a]];\n    saveOrder(ids);''','''    [ids[a], ids[b]] = [ids[b], ids[a]];\n    saveOrder(ids);\n    markMoved(id);''')\nrep2('''                    onDropOn={(dragged) => moveBefore(dragged, req.id)}''','''                    onDropOn={(dragged, where) => moveBefore(dragged, req.id, where)}\n                    dragging={dragging === req.id}\n                  