<li className=\"relative\">\n                    <span aria-hidden className=\"absolute -left-[21px] top-0.5 size-2.5 rounded-full bg-l3 ring-2 ring-surface\" />\n                    <p className=\"font-medium text-ink\">Backed by {signals.length} competitor feature{signals.length > 1 ? \"s\" : \"\"} or trend{signals.length > 1 ? \"s\" : \"\"}</p>\n                    <p className=\"text-muted\">{signals.map((x) => (x.kind === \"competitor\" ? x.competitor : x.title)).join(\" · \")}</p>\n                  </li>\n                )}\n                <li className=\"relative\">\n                  <span aria-hidden className={`absolute -left-[21px] top-0.5 size-2.5 rounded-full ring-2 ring-surface ${decision.action === \"reject\" ? \"bg-bad\" : \"bg-human\"}`} />\n                  <p className=\"font-medium text-ink\">\n                    {decision.action === \"keep\" ? \"Kept\" : decision.action === \"reject\" ? \"Rejected\" : \"Wishlisted\"} by {decision.by}\n                    {priority !== undefined && ` · priority #${priority}`}\n                  </p>\n                  <p className=\"text-muted\">\n                    {decision.role && `${decision.role} · `}\n                    {new Date(decision.at).toLocaleString(\"en-GB\", { dateStyle: \"medium\", timeStyle: \"short\" })}\n                    {decision.mentionsAt !== undefined && ` · ${decision.mentionsAt} customers asking then`}\n                  </p>\n                  {decision.reason && <p className=\"mt-0.5 text-ink-soft\">“{decision.reason}”</p>}\n                </li>\n                <li className=\"relative\">\n                  <span aria-hidden className=\"absolute -left-[21px] top-0.5 size-2.5 rounded-full bg-brand ring-2 ring-surface\" />\n                  <p className=\"font-medium text-ink\">Placed in this profile by the agent</p>\n                  <p className=\"text-muted\">Following your priority order and the profile&apos;s theme.</p>\n                </li>\n              </ol>\n            </Block>\n          )}\n\n          {scored && ('''),\n])\n\n# Profile catalogue: info icon per requirement row → trace panel\nedit('src/components/pipeline/Profiles.tsx', [\n ('import { ArrowLeft, ArrowRight, Download, ExternalLink, Star, Trophy } from \"lucide-react\";','import { ArrowLeft, ArrowRight, Download, ExternalLink, Info, Star, Trophy } from \"lucide-react\";\\nimport { useState } from \"react\";'),\n ('import { CATEGORY_ICON, SIGNAL_ICON } from \"./icons\";','import { CATEGORY_ICON, SIGNAL_ICON } from \"./icons\";\\nimport { RequestDetails } from \"./RequestCard\";'),\n ('''  const color = PROFILE_COLOR[profile.id];\n  const included''','''  const color = PROFILE_COLOR[profile.id];\n  const [trace, setTrace] = useState<(FeatureRequest & { priority: number }) | null>(null);\n  const included'''),\n ('''                              <p className={mine ? \"font-medium text-ink\" : \"\"}>\n                                {r.title} <span className=\"text-[11px] font-normal text-muted\">#{r.priority}</span>\n                              </p>''','''                              <p className={`flex items-center gap-1.5 ${mine ? \"font-medium text-ink\" : \"\"}`}>\n                                {r.title} <span className=\"text-[11px] font-normal text-muted\">#{r.priority}</span>\n                                <button\n                                  type=\"button\"\n                                  data-no-print\n                                  onClick={() => setTrace(r)}\n                                  aria-label={`Where “${r.title}” comes from`}\n                                  title=\"Where this comes from: feedback, competitors and trends, and the decision\"\n                                  className=\"flex size-6 items-center justify-center rounded-full text-muted hover:bg-brand-soft hover:text-brand\"\n                                >\n                                  <Info aria-hidden className=\"size-3.5\" />\n                  