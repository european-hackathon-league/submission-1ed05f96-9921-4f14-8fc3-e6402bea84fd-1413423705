  key={m}","+                  type=\"button\"","+                  aria-pressed={s.memoryScope === m}","+                  onClick={() => set({ memoryScope: m })}","+                  className={`rounded-full px-3 py-1 text-sm ${s.memoryScope === m ? \"bg-surface font-medium text-ink shadow-card\" : \"text-muted\"}`}","+                >","+                  {m === \"market\" ? \"Same market\" : \"All markets\"}","+                </button>","+              ))}","+            </div>","+          </div>","+          <label className=\"flex items-center justify-between gap-3 text-sm text-ink-soft\">","+            Hide requests rejected before (instead of ranking them lower)","+            <input type=\"checkbox\" checked={s.hideRejected} onChange={(e) => set({ hideRejected: e.target.checked })} className=\"size-4 accent-[var(--brand)]\" />","+          </label>","+        </Card>","+","+        <Card icon={<TrendingUp aria-hidden className=\"size-4\" />} title=\"Resurfacing\" note=\"When the market changes, a rejected request can come back.\">","+          <Slider","+            label=\"Demand growth since the reject that lifts the penalty\"","+            value={s.resurfaceAt}","+            min={0.1}","+            max={1.5}","+            step={0.05}","+            onChange={(v) => set({ resurfaceAt: v })}","+            display={`+${Math.round(s.resurfaceAt * 100)}%`}","+          />","+        </Card>","+","+        <button","+          type=\"button\"","+          onClick={() => saveScoring(DEFAULT_SCORING)}","+          className=\"inline-flex items-center gap-1.5 self-start rounded-full px-4 py-2 text-sm text-ink-soft ring-1 ring-line hover:bg-bg-soft\"","+        >","+          <RotateCcw aria-hidden className=\"size-4\" /> Reset to defaults","+        </button>","+      </div>","+","+      <aside className=\"flex flex-col gap-4 lg:sticky lg:top-20 lg:self-start\">","+        <section className=\"rounded-card border border-line bg-surface p-5 shadow-card\">","+          <h2 className=\"text-sm font-semibold text-ink\">Live example</h2>","+          <p className=\"mt-0.5 text-xs text-muted\">One made-up request, scored with these settings.</p>","+          <ul className=\"mt-3 divide-y divide-line text-sm\">","+            {cases.map((c) => (","+              <li key={c.label} className=\"flex items-center justify-between gap-3 py-2\">","+                <span className=\"text-ink-soft\">{c.label}</span>","+                <span className={`font-semibold tabular-nums ${c.r.state === \"rejected\" ? \"text-bad\" : c.r.state === \"resurfaced\" ? \"text-wait\" : \"text-ink\"}`}>","+                  {c.r.hidden ? \"hidden\" : c.r.score}","+                </span>","+              </li>","+            ))}","+          </ul>","+        </section>","+        <section className=\"rounded-card border border-line bg-bg-soft p-5 text-xs leading-relaxed text-ink-soft\">","+          <p className=\"font-semibold text-ink\">The formula</p>","+          <p className=\"mt-1 font-mono\">base = (wD·demand + wB·backing + wF·fit) / (wD+wB+wF)</p>","+          <p className=\"font-mono\">strength = 0.5 ^ (days / half-life)</p>","+          <p className=\"font-mono\">reject: score = base × (1 − penalty × strength)</p>","+          <p className=\"font-mono\">resurfaced (growth ≥ threshold): score = base</p>","+          <p className=\"font-mono\">keep: score = base + 10 × bonus × strength</p>","+          <p className=\"mt-2\">Saved in this browser for now. The backend agent applies the same rules before it proposes requests.</p>","+        </section>","+      </aside>","+    </div>","+  );","+}","+","+function Card({ icon, title, note, children }: { icon: React.ReactNode; title: string; note: string; children: React.ReactNode }) {","+  return (","+    <section className=\"rounded-card border border-line bg-surface p-5 shadow-card\">","+      <h2 className=\"flex items-center gap-2 text-sm font-semibold text-ink\">","+        <span className=\"text-brand\">{icon}</span>","+        {title}","+      </h2>","+      <p className=\"mt-0.5 text-xs text-muted\">{note}</p>","+      <div className=\"mt-4 flex flex-col gap-4\">{children}</div>","+    </section>","+  );","+}","+","+function Slider({","+  label,","+  value,","+  onChange,","+  min = 0,","+  max = 1,","+  step = 0.05,","+  share,","+  display,","+}: {","+  label: string;","+  value: number;","+  onChange: (v: number) => void;","+  min?: number;","+  max?: number;","+  step?: number;","+  share?: number;","+  display?: string;","+}) {","+  return (","+    <label className=\"flex flex-col gap-1.5\">","+      <span className=\"flex items-baseline justify-between gap-3 text-sm text-ink-soft\">","+        {label}","+        <span className=\"shrink-0 font-semibold tabular-nums text-ink\">{display ?? `${Math.round((share ?? value) * 100)}%`}</span>","+      </span>","+      <input type=\"range\" min={min} max={max} step={step} value={value} onChange={(e) => onChange(Number(e.target.value))} className=\"w-full accent-[var(--brand)]\" />","+    </label>","+  );","+}"]}],"created":true},{"filePath":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/dashboard/TopBar.tsx","hunks":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":5,"lines":[" import Link from \"next/link\";","-import { Plus } from \"lucide-react\";","+import { Plus, SlidersHorizontal } from \"lucide-react\";"," import { Logo } from \"@/components/brand/Logo\";"," import { UserMenu } from \"./UserMenu\";"," "]},{"oldStart":18,"oldLines":6,"newStart":18,"newLines":9,"lines":["         <Link href=\"/dashboard/new\" className=\"ml-auto inline-flex items-center gap-1.5 rounded-full bg-brand px-3.5 py-1.5 text-sm font-medium text-white shadow-card hover:bg-brand-deep\">","           <Plus aria-hidden className=\"size-4\" /> New analysis","         </Link>","+        <Link href=\"/dashboard/settings\" aria-label=\"Settings\" title=\"Scoring settings\" className=\"flex size-9 items-center justify-center rounded-full text-ink-soft ring-1 ring-line hover:bg-bg-soft hover:text-ink\">","+          <SlidersHorizontal aria-hidden className=\"size-4\" />","+        </Link>","         <UserMenu />","       </div>","     </header>"]}]}],"moreFiles":0,"changedFiles":["/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/app/dashboard/settings/page.tsx","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/dashboard/ScoringSettings.tsx","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/dashboard/TopBar.tsx"]}},"sourceToolAssistantUUID":"89319605-c850-4d8d-b16d-e0410e9c1393","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"53e0d48f-0e86-4176-8390-70cad3fe3f46","userType":"external","entrypoint":"cli","cwd":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web","sessionId":"7fd52f13-5d0c-4e7f-8ec6-8a947b2499a1","version":"2.1.296","gitBranch":"main","slug":"federated-petting-ripple"}
