 gap-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-good\">","+                      <Check aria-hidden className=\"size-3.5\" /> Pipeline complete","+                    </p>","+                    <h2 className=\"mt-1 text-2xl font-semibold tracking-tight text-ink\">","+                      {tab === \"profiles\" ? \"Profiles\" : tab === \"analytics\" ? \"Analytics\" : tab === \"decisions\" ? \"Decisions\" : \"Sessions\"}","+                    </h2>","+                  </div>","+                  <p className=\"inline-flex items-center gap-1.5 rounded-full bg-bg-soft px-3 py-1 text-xs text-ink-soft ring-1 ring-line\">","+                    <FolderClock aria-hidden className=\"size-3.5 text-muted\" />","+                    Session <span className=\"font-mono font-semibold text-ink\">{session.id}</span> · {sessionTime(session.createdAt)}","                   </p>","-                  <h2 className=\"mt-1 text-2xl font-semibold tracking-tight text-ink\">","-                    {tab === \"profiles\" ? \"Profiles\" : tab === \"analytics\" ? \"Analytics\" : \"Decisions\"}","-                  </h2>","                 </div>","                 {tab === \"profiles\" && (","                   <ProfileList","-                    profiles={profiles}","+                    profiles={shown}","                     cfg={cfg}","+                    image={images?.front}","                     onOpen={(id) => {","                       setOpenProfile(id);","                       window.scrollTo({ top: 0, behavior: \"smooth\" });","                     }}","                   />","                 )}","-                {tab === \"analytics\" && (","-                  <Analytics","-                    profiles={profiles}","-                    campaigns={campaigns}","-                    cfg={cfg}","-                    scopeLabel={scopeLabel}","-                    onLaunch={() => setCampaigns(simulateCampaigns(profiles.map((p) => p.id), `${scope}-${cfg.id}`))}","+                {tab === \"analytics\" && <Analytics profiles={shown} campaigns={campaigns} cfg={cfg} scopeLabel={scopeLabel} onLaunch={launchSocial} />}","+                {tab === \"decisions\" && <DecisionLog decisions={session.decisions} />}","+                {tab === \"sessions\" && (","+                  <SessionList","+                    sessions={sessions}","+                    currentId={session.id}","+                    here={{ scope, series: cfg.id }}","+                    onOpen={openSession}","+                    onDelete={(id) => {","+                      deleteSession(id);","+                      setSessions(readSessions());","+                    }}","                   />","                 )}","-                {tab === \"decisions\" && <DecisionLog decisions={decisions} />}","               </section>","             )}","           </div>"]}]},{"filePath":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/lib/pipeline/profiles.ts","hunks":[{"oldStart":169,"oldLines":3,"newStart":169,"newLines":16,"lines":["   if (r.types.difficult > r.types.wants) return `${t}: halve ease-of-use complaints in this area within 12 months of launch (baseline ${r.scoped} mentions).`;","   return `${t}: available at launch; wishes for it drop by half within 12 months (baseline ${r.scoped} mentions).`;"," }","+","+/** Re-score saved profiles once a social test (L3) has run, and re-rank them. */","+export function applySocial(profiles: Profile[], social: Record<string, number> | null, l3Weight: number): Profile[] {","+  return profiles","+    .map((p) => {","+      const l3 = social ? social[p.id] ?? null : null;","+      const w3 = l3 === null ? 0 : l3Weight;","+      const w1 = 0.45 * (1 - w3);","+      const w2 = 1 - w1 - w3;","+      return { ...p, score: { ...p.score, l3, total: w1 * p.score.l1 + w2 * p.score.l2 + w3 * (l3 ?? 0) } };","+    })","+    .sort((a, b) => b.score.total - a.score.total);","+}"]}]}],"moreFiles":0,"changedFiles":["/Volume