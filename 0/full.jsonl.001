  );","+  if (scored.state === \"resurfaced\")","+    return (","+      <span","+        title={`Rejected on ${shortDate(m.at)} by ${m.by}, but demand grew ${Math.round((scored.growth ?? 0) * 100)}% since`}","+        className=\"inline-flex shrink-0 items-center gap-1 rounded-full bg-wait-soft px-2 py-0.5 text-[0.7rem] font-medium text-wait\"","+      >","+        <TrendingUp aria-hidden className=\"size-3\" /> Resurfaced +{Math.round((scored.growth ?? 0) * 100)}%","+      </span>","+    );","+  return (","+    <span title={`Kept on ${shortDate(m.at)} by ${m.by}`} className=\"inline-flex shrink-0 items-center gap-1 rounded-full bg-good-soft px-2 py-0.5 text-[0.7rem] font-medium text-good\">","+      <RotateCcw aria-hidden className=\"size-3\" /> Kept before","+    </span>","+  );","+}","+"," /** Side panel with everything behind one request. Opens from the info icon; Esc or the backdrop closes it. */","-export function RequestDetails({ req, signals, onClose }: { req: FeatureRequest | null; signals: MarketSignal[]; onClose: () => void }) {","+export function RequestDetails({ req, signals, scored, onClose }: { req: FeatureRequest | null; signals: MarketSignal[]; scored?: Scored; onClose: () => void }) {","   const ref = useRef<HTMLDialogElement>(null);","   useEffect(() => {","     const d = ref.current;"]},{"oldStart":256,"oldLines":6,"newStart":309,"newLines":45,"lines":["           </div>","           <p className=\"text-ink-soft\">{req.summary}</p>"," ","+          {scored && (","+            <Block title=\"Dixi score\">","+              <div className=\"flex items-center gap-4\">","+                <p className=\"text-3xl font-semibold tabular-nums\">{scored.score}</p>","+                <dl className=\"grid flex-1 grid-cols-3 gap-2 text-xs\">","+                  {(","+                    [","+                      [\"Demand\", scored.parts.demand],","+                      [\"Market backing\", scored.parts.backing],","+                      [\"Principle fit\", scored.parts.fit],","+                    ] as const","+                  ).map(([k, v]) => (","+                    <div key={k}>","+                      <dt className=\"text-muted\">{k}</dt>","+                      <dd className=\"font-medium tabular-nums text-ink\">{Math.round(v * 100)}</dd>","+                    </div>","+                  ))}","+                </dl>","+              </div>","+              {scored.memory && (","+                <div className={`mt-3 rounded-lg p-3 text-xs ${scored.state === \"rejected\" ? \"bg-bad-soft/60\" : scored.state === \"resurfaced\" ? \"bg-wait-soft\" : \"bg-good-soft\"}`}>","+                  <p className=\"font-semibold text-ink\">","+                    {scored.state === \"rejected\" ? \"Rejected in an earlier generation\" : scored.state === \"resurfaced\" ? \"Rejected before, now resurfaced\" : \"Kept in an earlier generation\"}","+                  </p>","+                  {scored.memory.reason && <p className=\"mt-0.5 text-ink-soft\">“{scored.memory.reason}”</p>}","+                  <p className=\"mt-1 text-muted\">","+                    {scored.memory.by}","+                    {scored.memory.role && ` (${scored.memory.role})`} · {shortDate(scored.memory.at)} · {scored.memory.scopeLabel} · {scored.memory.generationId}","+                  </p>","+                  <p className=\"mt-1 text-muted\">","+                    Customers asking then: {scored.memory.mentionsAt ?? \"–\"} · now: {req.mentions === undefined ? \"–\" : \"\"}","+                    {scored.growth !== null && ` (${scored.growth >= 0 ? \"+\" : \"\"}${Math.round(scored.growth * 100)}%)`}","+                    {scored.state === \"rejected\" && ` · score lowered from ${scored.base} (memory strength ${Math.round(scored.strength * 100)}%)`}","+                  </p>","+                </div>","+              )}","+            </Block>","+          )}","+","           <div className=\"grid grid-cols-3 gap-2\">","             {([\"wants\", \"d