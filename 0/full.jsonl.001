ndow.addEventListener(EVENT, cb);","+  window.addEventListener(\"storage\", cb);","+  return () => {","+    window.removeEventListener(EVENT, cb);","+    window.removeEventListener(\"storage\", cb);","+  };","+}","+","+export const useScoring = () => useSyncExternalStore(subscribe, read, () => DEFAULT_SCORING);","+"]}],"created":true},{"filePath":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/lib/pipeline/scoring.ts","hunks":[{"oldStart":6,"oldLines":10,"newStart":6,"newLines":10,"lines":["  *            kept     → small bonus that fades the same way","  *   score  = base × (1 − penalty) + bonus","  *","+ * Pure functions (usable on server and client). The settings store lives in scoring-store.ts (client only).","  * Settings are tuned by the team in /dashboard/settings and stored in this browser for now (Supabase later).","  * The backend agent will apply the same rules before it proposes requests (see docs/architecture/09-scoring-and-memory.md).","  */","-import { useSyncExternalStore } from \"react\";"," import type { MarketScope } from \"@/lib/dashboard-data\";"," import type { Decision } from \"./profiles\";"," import type { Session } from \"./sessions\";"]},{"oldStart":46,"oldLines":51,"newStart":46,"newLines":6,"lines":["   memoryScope: \"market\","," };"," ","-/* ---------- settings store (localStorage, reactive) ---------- */","-","-const KEY = \"dixi:scoring\";","-const EVENT = \"dixi:scoring\";","-let cacheRaw: string | null | undefined;","-let cache: ScoringSettings = DEFAULT_SCORING;","-","-function read(): ScoringSettings {","-  let raw: string | null = null;","-  try {","-    raw = localStorage.getItem(KEY);","-  } catch {","-    /* storage blocked */","-  }","-  if (raw !== cacheRaw) {","-    cacheRaw = raw;","-    try {","-      cache = { ...DEFAULT_SCORING, ...(raw ? (JSON.parse(raw) as Partial<ScoringSettings>) : {}) };","-    } catch {","-      cache = DEFAULT_SCORING;","-    }","-  }","-  return cache;","-}","-","-export function