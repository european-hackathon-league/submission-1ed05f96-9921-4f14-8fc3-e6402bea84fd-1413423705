ge_tokens\": 439,","+      \"text_tokens\": 0","+    },","+    \"total_tokens\": 580","+  },","+  \"created\": \"2026-10-10T20:53:32.286Z\"","+}"]}],"created":true},{"filePath":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/pipeline/Analytics.tsx","hunks":[{"oldStart":1,"oldLines":10,"newStart":1,"newLines":12,"lines":[" \"use client\";"," ","-import { Megaphone, Table2, TrendingDown, TrendingUp, Trophy } from \"lucide-react\";","+import Image from \"next/image\";","+import { Heart, Megaphone, MessageCircle, Repeat2, Sparkles, Table2, TrendingDown, TrendingUp, Trophy } from \"lucide-react\";"," import { useEffect, useRef, useState } from \"react\";"," import { CAMPAIGN_DAYS, momentum, type Campaign } from \"@/lib/pipeline/analytics\";"," import type { Profile } from \"@/lib/pipeline/profiles\";"," import type { SeriesConfig } from \"@/lib/pipeline/series\";","+import { buildPost } from \"@/lib/pipeline/posts\";"," "," /* Colour follows the profile, never its rank (fixed slot per archetype). */"," export const PROFILE_COLOR: Record<string, { stroke: string; bg: string; text: string }> = {"]},{"oldStart":29,"oldLines":8,"newStart":31,"newLines":10,"lines":["   scopeLabel: string;","   onLaunch: () => void;"," }) {","+  const posts = <Posts profiles={profiles} campaigns={campaigns} cfg={cfg} scopeLabel={scopeLabel} />;","   if (!campaigns) {","     return (","+      <div className=\"flex flex-col gap-6\">","       <section className=\"flex flex-col items-center gap-4 rounded-card border border-dashed border-l3/60 bg-l3-soft/40 px-6 py-12 text-center\">","         <span className=\"flex size-12 items-center justify-center rounded-2xl bg-surface text-l3 shadow-card\">","           <Megaphone aria-hidden className=\"size-6\" />"]},{"oldStart":46,"oldLines":6,"newStart":50,"newLines":8,"lines":["           Launch test (simulated)","         </button>","       </section>","+      {posts}","+      </div>","     );","   }"," "]},{"oldStart":103,"oldLines":6,"newStart":109,"newLines":8,"lines":["         })}","       </ul>"," ","+      {posts}","+","       <EngagementChart profiles={profiles} campaigns={campaigns} />","     </div>","   );"]},{"oldStart":278,"oldLines":3,"newStart":286,"newLines":78,"lines":["     </section>","   );"," }","+","+/* ---------- the posts: one story per profile ---------- */","+","+function Posts({ profiles, campaigns, cfg, scopeLabel }: { profiles: Profile[]; campaigns: Campaign[] | null; cfg: SeriesConfig; scopeLabel: string }) {","+  const byId = new Map((campaigns ?? []).map((c) => [c.profileId, c]));","+  const leader = campaigns ? [...campaigns].sort((a, b) => b.l3 - a.l3)[0]?.profileId : null;","+  return (","+    <section aria-labelledby=\"posts-heading\" className=\"flex flex-col gap-3\">","+      <div className=\"flex flex-wrap items-baseline justify-between gap-2\">","+        <h3 id=\"posts-heading\" className=\"flex items-center gap-2 text-sm font-semibold text-ink\">","+          <Sparkles aria-hidden className=\"size-4 text-l3\" /> The posts · one story per profile","+        </h3>","+        <p className=\"text-xs text-muted\">Built from what {scopeLabel} customers asked for. {campaigns ? \"Results after 14 days.\" : \"Ready to post.\"}</p>","+      </div>","+      <ul className=\"grid gap-4 md:grid-cols-3\">","+        {profiles.map((p) => {","+          const post = buildPost(p, cfg, scopeLabel);","+          const c = byId.get(p.id);","+          const eng = c ? c.impressions * c.engagement : 0;","+          return (","+            <li key={p.id} className={`flex flex-col overflow-hidden rounded-card border bg-surface shadow-card ${leader === p.id ? \"border-brand/50 ring-2 ring-brand/15\" : \"border-line\"}`}>","+              <div className=\"flex items-center gap-2.5 px-4 py-3\">","+                <span className=\"flex size-8 items-center justify-center rounded-full text-xs font-semibold text-white\" style={{ backgroundColor: PROFILE_COLOR[p.id]?.stroke }}>","+                  {p.name.charAt(0)}","+                </span>","+                <div className=\"min-w-0 flex-1 leading-tight\">","+                  <p className=\"truncate text-sm font-semibold text-ink\">{p.name}</p>","+                  <p className=\"text-[0.7rem] text-muted\">","+                    Concept test · {cfg.name} · {scopeLabel}","+                  </p>","+                </div>","+                {leader === p.id && (","+                  <span className=\"inline-flex items-center gap-1 rounded-full bg-brand-soft px-2 py-0.5 text-[0.7rem] font-medium text-brand-deep\">","+                    <Trophy aria-hidden className=\"size-3\" /> Best","+                  </span>","+                )}","+              </div>","+              <figure className=\"relative aspect-square bg-bg-soft\">","+                <Image src={post.image} alt={post.alt} fill sizes=\"(min-width: 768px) 30vw, 100vw\" className=\"object-cover\" />","+                <figcaption className=\"absolute left-2 top-2 rounded bg-ink/70 px-1.5 py-0.5 text-[0.65rem] font-medium text-white backdrop-blur\">AI-generated image</figcaption>","+                <p className=\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 to-transparent px-4 pb-3 pt-10 text-lg font-semibold leading-tight tracking-tight text-white\">","+                  {post.headline}","+                </p>","+              </figure>","+              {c && (","+                <div className=\"flex items-center gap-4 border-b border-line px-4 py-2.5 text-sm text-ink-soft\">","+                  <span className=\"inline-flex items-center gap-1.5\" title=\"Likes\">","+                    <Heart aria-hidden className=\"size-4 text-bad\" fill=\"currentColor\" />","+                    {compact(eng * 0.72)}","+                  </span>","+                  <span className=\"inline-flex items-center gap-1.5\" title=\"Comments\">","+                    <MessageCircle aria-hidden className=\"size-4\" />","+                    {compact(eng * 0.16)}","+                  </span>","+                  <span className=\"inline-flex items-center gap-1.5\" title=\"Shares\">","+                    <Repeat2 aria-hidden className=\"size-4\" />","+                    {compact(c.shares)}","+                  </span>","+                  <span className=\"ml-auto text-xs font-medium text-good\" title=\"Share of positive reactions\">","+                    {pct(c.positive, 0)} positive","+                  </span>","+                </div>","+              )}","+              <div className=\"flex flex-1 flex-col gap-2 px-4 py-3 text-sm\">","+                <p className=\"leading-relaxed text-ink-soft\">{post.caption}</p>","+                <p className=\"mt-auto text-xs text-brand\">{post.hashtags.join(\" \")}</p>","+              </div>","+            </li>","+          );","+        })}","+      </ul>","+      <p className=\"text-[0.7rem] text-muted\">Images are AI-generated concept visuals (no real car, logo or person). Copy is drafted from each profile&apos;s top requests.</p>","+    </section>","+  );","+}"]}]}],"moreFiles":1,"changedFiles":["/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/public/images/posts/f70-comfort.png","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/public/images/posts/f70-comfort.png.json","/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web/src/components/pipeline/Analytics.tsx"]}},"sourceToolAssistantUUID":"9f9fd91c-2977-4cf9-b24b-0832a56f1d79","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"53e0d48f-0e86-4176-8390-70cad3fe3f46","userType":"external","entrypoint":"cli","cwd":"/Volumes/PJ/peresjav/hackathons/ehl-final-minuch-2026/web","sessionId":"7fd52f13-5d0c-4e7f-8ec6-8a947b2499a1","version":"2.1.296","gitBranch":"main","slug":"federated-petting-ripple"}
