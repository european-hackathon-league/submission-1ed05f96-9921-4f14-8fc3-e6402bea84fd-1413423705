) => d.engagement))) * 1.1;","   const x = (day: number) => pad.l + ((day - 1) / (CAMPAIGN_DAYS - 1)) * (W - pad.l - pad.r);","   const y = (v: number) => pad.t + (1 - v / max) * (H - pad.t - pad.b);","   const ticks = [0, max / 3, (2 * max) / 3].map((v) => Math.round(v * 1000) / 1000);","   const name = (id: string) => profiles.find((p) => p.id === id)?.name ?? id;","+  /* End labels: keep at least 16px apart so close lines don't collide. */","+  const labelY = new Map<string, number>();","+  [...campaigns]","+    .map((c) => ({ id: c.profileId, y: y(c.days[c.days.length - 1].engagement) }))","+    .sort((a, b) => a.y - b.y)","+    .forEach((l, i, arr) => {","+      const prev = i > 0 ? labelY.get(arr[i - 1].id)! : -Infinity;","+      labelY.set(l.id, Math.max(l.y, prev + 16));","+    });"," ","   return (","     <section className=\"rounded-card border border-line bg-surface shadow-card\">"]},{"oldStart":178,"oldLines":10,"newStart":196,"newLines":12,"lines":["           </table>","         </div>","       ) : (","-        <div className=\"relative px-2 py-3\">","+        <div ref={box} className=\"relative py-3\">","           <svg","+            width={W}","+            height={H}","             viewBox={`0 0 ${W} ${H}`}","-            className=\"h-auto w-full\"","+            className=\"block\"","             role=\"img\"","             aria-label={`Engagement rate per day for ${campaigns.map((c) => name(c.profileId)).join(\", \")}`}","             onMouseLeave={() => setHover(null)}"]},{"oldStart":195,"oldLines":13,"newStart":215,"newLines":13,"lines":["             {ticks.map((t) => (","               <g key={t}>","                 <line x1={pad.l} x2={W - pad.r} y1={y(t)} y2={y(t)} stroke=\"var(--line)\" strokeWidth={1} />","-                <text x={pad.l - 8} y={y(t) + 4} textAnchor=\"end\" className=\"fill-muted text-[11px]\">","+                <text x={pad.l - 8} y={y(t) + 4} textAnchor=\"end\" className=\"fill-muted text-[12px]\">","                 