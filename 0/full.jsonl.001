 = order.indexOf(a.req.id);\n          const ib = order.indexOf(b.req.id);\n          if (ia !== -1 || ib !== -1) return (ia === -1 ? Infinity : ia) - (ib === -1 ? Infinity : ib);\n          return b.scoped - a.scoped;\n        }),\n    [data.requests, scope, fallback, order],''','''        .map((r) => ({ req: r, scoped: scopedMentions(r, scope, fallback) }))\n        .filter((x) => x.scoped > 0)\n        .map((x, _i, all) => {\n          const max = Math.max(...all.map((y) => y.scoped));\n          const scored = scoreRequest(x.req, x.scoped, max, signalsByTitle.get(x.req.title)?.length ?? 0, cfg.focus, memory, scoring);\n          return { ...x, urgency: urgencyOf(x.scoped), scored };\n        })\n        /* Default order = Dixi score (demand, market backing, principle fit, decision memory). The PM's drag order wins. */\n        .sort((a, b) => {\n          const ia = order.indexOf(a.req.id);\n          const ib = order.indexOf(b.req.id);\n          if (ia !== -1 || ib !== -1) return (ia === -1 ? Infinity : ia) - (ib === -1 ? Infinity : ib);\n          return b.scored.score - a.scored.score || b.scoped - a.scoped;\n        }),\n    [data.requests, scope, fallback, order, signalsByTitle, cfg.focus, memory, scoring],''')\nrep('''      (!focus || focusTitles.has(r.req.title)),\n  );''','''      (!focus || focusTitles.has(r.req.title)) &&\n      (showHidden || !r.scored.hidden),\n  );\n  const hiddenCount = rows.filter((r) => r.scored.hidden).length;''')\nrep('''                {visible.map(({ req, scoped, urgency: u }) => (''','''                {visible.map(({ req, scoped, urgency: u, scored }) => (''')\nrep('''                    onKeep={() => decide(req, \"keep\")}''','''                    scored={scored}\n                    onKeep={() => decide(req, \"keep\", undefined, scoped)}''')\nrep('''          if (rejecting) decide(rejecting, \"reject\", reason);''','''          if (rejecting) decide(rejecting, \"reject\", reason, rows.find((r) => r.req.id === rejecting.