rt":45,"newLines":21,"lines":["   mem -. \"rejected requests stay out\" .-> build","   build --> profiles[\"3 car profiles<br/>Fix the basics · Tech-forward · Comfort &amp; craft<br/>score = L1 (principles + your priority) + L2 coverage\"]"," ","-  profiles --> done([\"Pipeline complete\"]) --> dash","-  done --> sess[(\"Sessions<br/>every build saved: profiles · decisions · priority · social test<br/>reopen any time from the sidebar or /dashboard/sessions\")]","+  profiles --> done([\"Pipeline complete<br/>saved as a generation\"]) --> sess[(\"Generations<br/>every build saved: profiles · decisions · priority · social test\")]","+  home[\"Dashboard /dashboard<br/>tabs: Generations (KPIs + cards) · New analysis (globe)\"] --> sess","+  home -- \"New analysis\" --> picker","+  sess -- \"open a generation\" --> dash","+  dash -. \"Edit and rebuild: decisions + priority loaded\" .-> list"," ","-  subgraph dash [\"Profiles dashboard\"]","+  subgraph dash [\"Generation dashboard /dashboard/generations#id\"]","     direction TB","     tabP[\"Tab · Profiles<br/>3 cards: score bar · top requirements · wishlist\"]","-    tabS[\"Sessions<br/>earlier generations\"]","     tabA[\"Tab · Analytics<br/>launch social test · 14-day engagement per profile<br/>reach · engagement · positive · momentum\"]","   end"," ","   tabP --> page[\"Profile page (catalogue style, like BMW's option list)<br/>cover · at a glance · requirements matrix ■ □ vs other profiles<br/>KPIs · requirements in your priority order + draft targets + options<br/>why the agent chose it · L1 principles · competitors &amp; trends<br/>decision trail incl. reject reasons\"]","   mem --> page","   page --> pdf[\"Download PDF<br/>A4 profile report\"]","-  sess --> tabS"," ","   tabA --> post[\"Post the profiles on social media<br/>(simulated for now)\"]","   post --> l3[\"L3 · Which profile tracks better<br/>low weight per series\"]"]},{"oldStart":69,"oldLines":7,"newStart":71,"newLines":7,"lines":["   classDef memory fi