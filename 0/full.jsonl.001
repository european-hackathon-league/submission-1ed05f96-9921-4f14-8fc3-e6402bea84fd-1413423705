src/lib/pipeline/profiles.ts <<'EOF'\n\n/** Re-score saved profiles once a social test (L3) has run, and re-rank them. */\nexport function applySocial(profiles: Profile[], social: Record<string, number> | null, l3Weight: number): Profile[] {\n  return profiles\n    .map((p) => {\n      const l3 = social ? social[p.id] ?? null : null;\n      const w3 = l3 === null ? 0 : l3Weight;\n      const w1 = 0.45 * (1 - w3);\n      const w2 = 1 - w1 - w3;\n      return { ...p, score: { ...p.score, l3, total: w1 * p.score.l1 + w2 * p.score.l2 + w3 * (l3 ?? 0) } };\n    })\n    .sort((a, b) => b.score.total - a.score.total);\n}\nEOF\npython3 - <<'EOF'\np='src/components/pipeline/Pipeline.tsx'; s=open(p).read()\ndef rep(a,b):\n    global s\n    assert a in s, a[:80]; s=s.replace(a,b,1)\n# state\nrep('''  const [campaigns, setCampaigns] = useState<Campaign[] | null>(null);\n  const [tab, setTab] = useState<\"profiles\" | \"analytics\" | \"decisions\">(\"profiles\");\n  const social = useMemo(() => (campaigns ? Object.fromEntries(campaigns.map((c) => [c.profileId, c.l3])) : null), [campaigns]);''','''  /** The session on screen in the profiles dashboard: the build you just made, or an earlier one you reopened. */\n  const [session, setSession] = useState<Session | null>(null);\n  const [sessions, setSessions] = useState<Session[]>([]);\n  const [tab, setTab] = useState<\"profiles\" | \"analytics\" | \"decisions\" | \"sessions\">(\"profiles\");\n  const campaigns = session?.campaigns ?? null;''')\nrep('''buildProfiles(kept, cfg, scope, fallback, social, wishlist, signals) : []),\n    [kept, cfg, scope, fallback, social, wishlist, signals],\n  );''','''buildProfiles(kept, cfg, scope, fallback, null, wishlist, signals) : []),\n    [kept, cfg, scope, fallback, wishlist, signals],\n  );\n\n  /* Profiles shown in the dashboard come from the session, re-scored when its social test has run. */\n  const shown = useMemo(\n    () => (session ? applySocial(session.profiles, session.campaigns ? Object.fromEntries(session.campaigns.map((c) => [c.profileId, c.l3])) : null, cfg.l3Weight) : []),\n    [session, cfg.l3Weight],\n  );\n\n  const openSession = useCallback((s: Session) => {\n    setSession(s);\n    setDecisions(s.decisions);\n    setOrder(s.order);\n    setOpenProfile(null);\n    setTab(\"profiles\");\n    setStage(\"profiles\");\n    setSessions(readSessions());\n  }, []);\n\n  /* Built: save a snapshot as a new session and show it. */\n  const finishBuild = useCallback(() => {\n    const s: Session = {\n      id: newSessionId(),\n      createdAt: new Date().toISOString(),\n      scope,\n      scopeLabel,\n      series: cfg.id,\n      seriesName: cfg.name,\n      slug: cfg.slug,\n      profiles,\n      decisions,\n      order: rows.map((r) => r.req.id),\n      campaigns: null,\n    };\n    saveSession(s);\n    openSession(s);\n  }, [scope, scopeLabel, cfg, profiles, decisions, rows, openSession]);\n\n  const launchSocial = () => {\n    if (!session) return;\n    const c = simulateCampaigns(session.profiles.map((p) => p.id), `${scope}-${cfg.id}-${session.id}`);\n    updateSession(session.id, { campaigns: c });\n    setSession({ ...session, campaigns: c });\n  };\n\n  /* Deep link from the sessions list: /dashboard/<market>/<series>#session=<id> */\n  useEffect(() => {\n    const id = new URLSearchParams(window.location.hash.slice(1)).get(\"session\");\n    if (!id) return;\n    const t = setTimeout(() => {\n      const s = readSessions().find((x) => x.id === id);\n      if (s) openSession(s);\n    }, 0);\n    return () => clearTimeout(t);\n  }, [openSession]);''')\nrep('''  const current = openProfile ? profiles.find((p) => p.id === openProfile) : undefined;''','''  const current = openProfile ? shown.find((p) => p.id === openProfile) : undefined;''')\nrep('''<Building count={kept.length} onDone={() => setStage(\"profiles\")} />''','''<Building count={kept.length} onDone={finishBuild} />''')\n# profiles stage\na=s.index('      {stage === \"profiles\