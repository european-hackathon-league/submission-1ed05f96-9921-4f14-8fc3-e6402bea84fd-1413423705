# Dixi web app: copy to web/.env.local (git-ignored) and fill in.
# Only NEXT_PUBLIC_* values reach the browser. Never put secret keys here.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dixi backend API (backend/, FastAPI). Enables "Run research agent"; without it the app uses the saved research.
# Local: http://localhost:8000 · production: the FastAPI Cloud URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (public values only). Local defaults come from `supabase start`;
# hosted values from the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (never NEXT_PUBLIC_): lets /api/scoring-advice turn a manager's instruction into scoring settings.
# Locally the route also reads the repo-root .env. Without a key it falls back to simple keyword rules.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-6-luna
